---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ProjectHero from "../components/ProjectHero.astro";
import ProjectActions from "../components/ProjectActions.astro";
import type { ProjectMeta } from "../data/projects";
import { site } from "../data/site";
import "../styles/project.css";
import "../styles/demos-common.css";
import "../styles/workshop-reading.css";
import { projectChapters } from "../data/project-chapters";
import type { ProjectKey } from "../data/projects";

interface Props { project: ProjectMeta; }
const { project } = Astro.props;
const origin = Astro.site;
if (!origin) throw new Error("Astro.site must be configured");
const home = new URL("/", origin).href;
const canonical = new URL(project.route, origin).href;
const image = project.hero.image;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: home },
      { "@type": "ListItem", position: 2, name: project.title, item: canonical }
    ]},
    { "@type": "CreativeWork", name: project.title, description: project.description, url: canonical, image: new URL(image.jpg, origin).href, author: { "@type": "Person", name: site.name, url: home } }
  ]
};
---
<BaseLayout
  title={`${project.title} | ${site.name}`}
  description={project.description}
  socialDescription={project.socialDescription}
  canonical={project.route}
  image={image.jpg}
  imageWidth={image.width}
  imageHeight={image.height}
  imageAlt={image.alt}
  type="article"
  structuredData={structuredData}
  bodyClass="project-page"
  headScript="project"
>
  <SiteHeader variant="project" />
  <main id="main" class="page-main shell" tabindex="-1">
    <ProjectHero project={project} />
    <div class="project-reading-layout">
      <details class="project-index" data-project-index open>
        <summary><span>In this build</span><span class="project-index-current" data-project-index-current aria-hidden="true"></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <nav aria-label="Case study sections">
          {projectChapters[project.id as ProjectKey].map(chapter => <a href={`#${chapter.id}`} data-project-section-link>{chapter.title}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>)}
        </nav>
      </details>
      <section class="project-writeup" aria-label="Project writeup"><slot /></section>
    </div>
    <ProjectActions project={project} />
  </main>
  <SiteFooter />
  <script src="../scripts/project-entry.js"></script>
  <script src="../scripts/demos/mount.js"></script>
  <slot name="scripts" />
</BaseLayout>
