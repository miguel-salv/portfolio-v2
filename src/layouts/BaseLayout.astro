---
import SeoHead from "../components/SeoHead.astro";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article" | "profile";
  robots?: string;
  socialDescription?: string;
  structuredData?: object;
  bodyClass?: string;
  headScript?: "home" | "project" | "default";
  importMap?: boolean;
}

const {
  bodyClass = "",
  headScript = "default",
  importMap = false,
  ...seo
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {headScript === "project" && <script is:inline>try{var h=JSON.parse(sessionStorage.getItem("project-image-handoff")||"null");if(h&&h.path===location.pathname&&Date.now()-h.time<5000){document.documentElement.classList.add("project-flip-pending");setTimeout(function(){document.documentElement.classList.remove("project-flip-pending")},2500)}}catch(_){}</script>}
    <script is:inline>try{var d=document.documentElement;var t=localStorage.getItem("portfolio-theme");if(t==="dark"||(!t&&matchMedia("(prefers-color-scheme:dark)").matches))d.dataset.theme="dark"}catch(_){}</script>
    {headScript === "home" && <script is:inline>try{var d=document.documentElement;var pending=null;try{pending=sessionStorage.getItem("portfolio-scroll")}catch(_){}if(!pending&&location.hash)pending=location.hash;if(pending){if("scrollRestoration"in history)history.scrollRestoration="manual";window.__portfolioHash=pending.charAt(0)==="#"?pending:"#"+pending;try{sessionStorage.removeItem("portfolio-scroll")}catch(_){}if(location.hash)history.replaceState(null,"",location.pathname+location.search);d.classList.add("hash-pending");setTimeout(function(){d.classList.remove("hash-pending")},2000)}else if(!localStorage.getItem("portfolio-boot")&&!matchMedia("(prefers-reduced-motion: reduce)").matches)d.dataset.boot="1"}catch(_){}</script>}
    <style is:inline>html{background:#ece1cd;color-scheme:light}html[data-theme="dark"]{background:#181817;color-scheme:dark}html.hash-pending:before{content:"";position:fixed;inset:0;z-index:2147483646;background:#ece1cd;pointer-events:none}html.hash-pending[data-theme="dark"]:before{background:#181817}</style>
    <SeoHead {...seo} />
    {importMap && <script type="importmap" is:inline>{JSON.stringify({ imports: { three: "/assets/vendor/three-0.170.0.module.min.js" } })}</script>}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
