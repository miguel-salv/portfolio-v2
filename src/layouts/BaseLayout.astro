---
import SeoHead from "../components/SeoHead.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/base.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  robots?: string;
  socialDescription?: string;
  structuredData?: object;
  preloadFonts?: "full" | "utility" | "none";
  bodyClass?: string;
  headScript?: "home" | "project" | "default";
}

const {
  bodyClass = "",
  headScript = "default",
  ...seo
} = Astro.props;
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <ClientRouter fallback="swap" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    {headScript === "project" && <script is:inline>try{var r=matchMedia("(prefers-reduced-motion:reduce)").matches;var h=JSON.parse(sessionStorage.getItem("project-image-handoff")||"null");if(r){sessionStorage.removeItem("project-image-handoff")}else if(h&&h.path===location.pathname&&Date.now()-h.time<5000){document.documentElement.classList.add("project-flip-pending");window.__projectFlipAbort=setTimeout(function(){document.documentElement.classList.remove("project-flip-pending","project-flip-running");document.querySelector(".project-flip-clone")?.remove();document.querySelector(".project-flip-wrap")?.remove();document.querySelector(".project-flip-shadow")?.remove()},2500)}}catch(_){}</script>}
    <script is:inline>try{var d=document.documentElement;var t=localStorage.getItem("portfolio-theme");if(t==="dark"||(!t&&matchMedia("(prefers-color-scheme:dark)").matches))d.dataset.theme="dark"}catch(_){}</script>
    <script is:inline>try{var d=document.documentElement;if("scrollRestoration"in history)history.scrollRestoration="manual";var pending=null;try{pending=sessionStorage.getItem("portfolio-scroll")}catch(_){}var savedY=null;try{var sy=JSON.parse(sessionStorage.getItem("portfolio-scroll-y")||"null");if(sy&&sy.path===location.pathname&&typeof sy.y==="number")savedY=sy.y}catch(_){}var atTop=savedY!==null&&savedY<=64&&!pending;if(atTop){try{sessionStorage.removeItem("portfolio-scroll")}catch(_){}try{var st=history.state&&typeof history.state==="object"?Object.assign({},history.state,{scrollX:0,scrollY:0}):{index:0,scrollX:0,scrollY:0};history.replaceState(st,"",location.pathname+location.search)}catch(_){}try{window.scrollTo(0,0)}catch(_){}}else if(!d.classList.contains("project-flip-pending")){if(!pending&&location.hash)pending=location.hash;if(pending||savedY>64){if(pending){window.__portfolioHash=pending.charAt(0)==="#"?pending:"#"+pending;try{sessionStorage.removeItem("portfolio-scroll")}catch(_){}if(location.hash)history.replaceState(null,"",location.pathname+location.search)}if(savedY>64)window.__portfolioScrollY=savedY;d.classList.add("hash-pending");setTimeout(function(){if(!d.classList.contains("hash-pending"))return;var y=Number(window.__portfolioScrollY)||0;if(!y)try{var s=JSON.parse(sessionStorage.getItem("portfolio-scroll-y")||"null");if(s&&s.path===location.pathname&&typeof s.y==="number")y=s.y}catch(_){}if(y>64){try{window.scrollTo(0,y)}catch(_){}}else{var h=window.__portfolioHash||pending;if(h&&h!=="#"){var id=h.charAt(0)==="#"?h.slice(1):h;var el=null;try{el=document.getElementById(decodeURIComponent(id))}catch(_){el=document.getElementById(id)}if(el){var top=el.getBoundingClientRect().top+window.scrollY;var margin=parseFloat(getComputedStyle(el).scrollMarginTop)||0;try{window.scrollTo(0,Math.max(0,Math.round(top-margin)))}catch(_){}}}}d.classList.remove("hash-pending")},2000)}}}catch(_){}</script>
    <style is:inline>html{background:#ece1cd;color-scheme:light}html[data-theme="dark"]{background:#181817;color-scheme:dark}html.hash-pending:before{content:"";position:fixed;inset:0;z-index:2147483646;background:#ece1cd;pointer-events:none}html.hash-pending[data-theme="dark"]:before{background:#181817}html.hash-pending .site-header{background:#ece1cd}html.hash-pending[data-theme="dark"] .site-header{background:#181817}</style>
    <SeoHead {...seo} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <div id="project-flip-stage" transition:persist aria-hidden="true"></div>
    {headScript === "project" && <script is:inline>try{if(!matchMedia("(prefers-reduced-motion:reduce)").matches){var h=JSON.parse(sessionStorage.getItem("project-image-handoff")||"null");if(h&&h.path===location.pathname&&Date.now()-h.time<5000){var imgR=h.rect;var frameR=h.frameRect||h.rect;var s=document.createElement("span");s.className="project-flip-shadow";s.setAttribute("aria-hidden","true");s.style.left=(scrollX+frameR.left)+"px";s.style.top=(scrollY+frameR.top)+"px";s.style.width=frameR.width+"px";s.style.height=frameR.height+"px";var c=document.createElement("img");c.className="project-flip-clone";c.src=h.src;c.alt="";c.setAttribute("aria-hidden","true");c.width=Math.max(1,Math.round(imgR.width));c.height=Math.max(1,Math.round(imgR.height));c.style.left=(scrollX+imgR.left)+"px";c.style.top=(scrollY+imgR.top)+"px";c.style.width=imgR.width+"px";c.style.height=imgR.height+"px";c.style.objectPosition=h.objectPosition||"50% 50%";(document.getElementById("project-flip-stage")||document.body).append(s,c)}}}catch(_){}</script>}
    <slot />
  </body>
</html>
