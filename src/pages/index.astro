---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PortfolioData from "../components/PortfolioData.astro";
import ProjectCardCopy from "../components/ProjectCardCopy.astro";
import ProjectCover from "../components/ProjectCover.astro";
import { projects } from "../data/projects";
import { Picture } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import "../styles/home.css";
import { site } from "../data/site";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${site.url}/#website`, url: `${site.url}/`, name: site.name, description: site.description, publisher: { "@id": `${site.url}/#person` } },
    { "@type": "Person", "@id": `${site.url}/#person`, name: site.name, url: `${site.url}/`, image: `${site.url}${site.socialImage}`, email: site.email, jobTitle: "Electrical and Computer Engineer", memberOf: { "@type": "CollegeOrUniversity", name: "Carnegie Mellon University" }, sameAs: ["https://www.linkedin.com/in/msalvacion/", "https://github.com/miguel-salv"] }
  ]
};
---
<BaseLayout
  title="Miguel Salvacion | Electrical and Computer Engineer"
  description="Miguel Salvacion is an electrical and computer engineer at Carnegie Mellon building embedded systems: EV hardware, firmware, PCB design, and RF automation."
  socialDescription={site.description}
  canonical="/"
  structuredData={structuredData}
  headScript="home"
>
  <PortfolioData />
  <div class="boot" aria-hidden="true">
    <div class="boot-log">
      <span style="--bl:0">[0.00] Vectors OK</span>
      <span style="--bl:1">[0.08] Peripherals: UART I2C ADC PWM</span>
      <span style="--bl:2">[0.20] Mapping 0x0000..0x0300</span>
      <span style="--bl:3">[0.36] Portfolio ready<i class="boot-cursor"></i></span>
    </div>
  </div>
  <noscript><style>.boot{display:none!important}:root[data-boot="1"] body{overflow:auto!important}</style></noscript>
  <SiteHeader variant="home" context="Available after graduation" />
  <main id="main" tabindex="-1">
<section class="hero shell" id="top">
        <div class="hero-grid">
          <div>
            <p class="eyebrow mono">Hello, I'm Miguel</p>
            <h1 data-animate-title>Electrical and Computer Engineer building <span class="accent-word">embedded systems</span><svg class="signal-trace" viewBox="0 0 88 20" width="88" height="20" aria-hidden="true" focusable="false"><path class="trace-path" /></svg></h1>
            <p class="lead">M.S. ECE at Carnegie Mellon. Available for full-time roles after graduation.</p>
            <div class="hero-actions">
              <a class="button internal" href="#projects">View projects</a>
              <a class="button secondary" href="resume/">View resume</a>
            </div>
            <nav class="contact-list" id="contact" aria-label="Contact links">
              <a class="contact-method" href="mailto:msalvacion@cmu.edu">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4.75 6.75h14.5v10.5H4.75z"/><path d="m5.25 7.25 6.75 5 6.75-5"/></svg>
                <strong>Email</strong>
                <span>msalvacion@cmu.edu</span>
              </a>
              <a class="contact-method" href="https://www.linkedin.com/in/msalvacion/" target="_blank" rel="noopener">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7.25 10.25v7"/><path d="M11.25 17.25v-4.1c0-1.75 1.05-2.9 2.7-2.9 1.78 0 2.8 1.16 2.8 3.16v3.84"/><path d="M7.25 7.25h.01"/><path d="M4.75 4.75h14.5v14.5H4.75z"/></svg>
                <strong>LinkedIn</strong>
                <span>linkedin.com/in/msalvacion</span>
              </a>
              <a class="contact-method" href="https://github.com/miguel-salv" target="_blank" rel="noopener">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M9 18.5c-3.25 1-3.25-1.75-4.5-2.25"/><path d="M15 21v-3.25c0-.9-.3-1.47-.85-1.85 2.75-.3 5.6-1.35 5.6-6.05 0-1.35-.47-2.45-1.25-3.3.12-.32.55-1.6-.12-3.3 0 0-1-.32-3.38 1.25a11.7 11.7 0 0 0-6 0C6.62 2.93 5.62 3.25 5.62 3.25c-.67 1.7-.24 2.98-.12 3.3a4.8 4.8 0 0 0-1.25 3.3c0 4.68 2.83 5.75 5.55 6.05-.45.4-.8 1.08-.8 2.18V21"/></svg>
                <strong>GitHub</strong>
                <span>github.com/miguel-salv</span>
              </a>
            </nav>
          </div>
          <div class="hero-media">
            <div class="portrait-card">
              <Picture src={portrait} formats={["avif", "webp"]} widths={[480, 768, 1200]} sizes="(max-width: 760px) 100vw, 45vw" alt="Miguel Salvacion" fetchpriority="high" />
              <span class="portrait-plate" data-live-age aria-hidden="true"></span>
            </div>
          </div>
        </div>
      </section>

      <section class="shell" id="about">
        <div class="section-head about-head" data-address="0x0100">
          <span class="mono">About</span>
          <h2 class="section-title">Hardware + firmware.</h2>
          <div class="about-copy">
            <p class="about-lead">M.S. ECE at Carnegie Mellon, focused on embedded systems, PCB design, and firmware.</p>
            <p class="about-detail">At Ford, I improved EV power delivery and led a cross-functional hardware audit. At CMU, I deployed automated RF matching at Hacker Fab, mentored embedded students, and shipped projects from a real-time vehicle to robotics and desktop hardware.</p>
          </div>
          <div class="hero-proof about-proof" aria-label="Credentials">
            <span class="proof-item"><img src="/assets/logos/ford.png" alt="" width="96" height="96" loading="lazy" /><span>Ford hardware systems</span></span>
            <span class="proof-item"><img src="/assets/logos/cmu.png" alt="" width="96" height="96" loading="lazy" /><span>CMU M.S. ECE</span></span>
            <span class="proof-item"><img src="/assets/logos/hacker-fab.png" alt="" width="200" height="200" loading="lazy" /><span>Deployed RF matcher</span></span>
          </div>
        </div>
        <div class="skill-marquee" aria-label="Skills">
          <div class="skill-track">
            <div class="skill-set">
              <span>Embedded Systems</span>
              <span>PCB Design</span>
              <span>EV Hardware</span>
              <span>Semiconductor Design</span>
              <span>C / C++</span>
              <span>RTOS</span>
              <span>RF Automation</span>
              <span>Python</span>
              <span>SolidWorks</span>
            </div>
            <div class="skill-set" aria-hidden="true">
              <span>Embedded Systems</span>
              <span>PCB Design</span>
              <span>EV Hardware</span>
              <span>Semiconductor Design</span>
              <span>C / C++</span>
              <span>RTOS</span>
              <span>RF Automation</span>
              <span>Python</span>
              <span>SolidWorks</span>
            </div>
          </div>
        </div>
      </section>


      <section class="shell" id="projects">
        <div class="section-head" data-address="0x0200">
          <span class="mono">My Projects</span>
          <h2 class="section-title">Built end to end.</h2>
        </div>
        <div class="projects-grid">
          <div class="project-card-wrap featured">
            <a class="project-card" href="project-impedance.html" data-fx="vswr">
              <ProjectCover project={projects.impedance} priority />
              <span class="fx-layer fx-pwr" aria-hidden="true">
                <span class="fx-chip fx-vswr" data-fx-vswr>Tuning&hellip;</span>
                <span class="fx-pwr-group">
                  <span class="fx-pwr-row">
                    <span class="fx-pwr-label">FWD</span>
                    <span class="fx-pwr-track"><span class="fx-pwr-fill fx-pwr-fwd" data-fx-fwd></span></span>
                    <span class="fx-pwr-val" data-fx-fwd-val>0 W</span>
                  </span>
                  <span class="fx-pwr-row">
                    <span class="fx-pwr-label">REF</span>
                    <span class="fx-pwr-track"><span class="fx-pwr-fill fx-pwr-ref" data-fx-ref></span></span>
                    <span class="fx-pwr-val" data-fx-ref-val>0 W</span>
                  </span>
                </span>
              </span>
              <ProjectCardCopy project={projects.impedance} />
            </a>
            <button type="button" class="instrument-toggle" data-instrument-toggle aria-expanded="false" aria-controls="instrument-panel" hidden>
              <span class="instrument-toggle-text">Try It Yourself</span>
              <span class="instrument-toggle-hint mono" aria-hidden="true">Interactive VSWR tuner</span>
              <svg class="instrument-toggle-chevron" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <aside id="instrument-panel" class="instrument" data-instrument aria-labelledby="instrument-title" hidden>
              <div class="instrument-intro">
                <h3 id="instrument-title">Match the Network Yourself</h3>
                <p>Drag <b>Capacitor 1</b>/<b>Capacitor 2</b> across the VSWR field, or auto-tune to watch the coordinate descent converge.</p>
              </div>
              <div class="instrument-panel">
                <div class="instrument-field" data-field></div>
                <div class="instrument-rail">
                  <div class="instrument-console">
                    <div class="instrument-vswr">
                      <span class="instrument-vswr-label mono">VSWR</span>
                      <span class="instrument-vswr-value" data-vswr>1.80</span>
                      <p class="instrument-status is-off" data-status>Reflecting</p>
                    </div>
                    <dl class="instrument-metrics">
                      <div><dt class="mono">Forward</dt><dd data-fwd>95&nbsp;W</dd></div>
                      <div><dt class="mono">Reflected</dt><dd data-ref>&mdash;</dd></div>
                      <div><dt class="mono">Return loss</dt><dd data-return-loss>&mdash;</dd></div>
                    </dl>
                    <div class="instrument-refbar" aria-hidden="true"><span class="instrument-refbar-fill" data-ref-bar></span></div>
                  </div>
                  <div class="instrument-controls">
                    <label class="instrument-slider">
                      <span class="instrument-slider-head mono">Capacitor 1 <span class="instrument-slider-val" data-c1-read>20&deg;</span></span>
                      <input type="range" data-c1 min="0" max="180" step="1" value="20" aria-label="Capacitor 1 position, degrees" />
                    </label>
                    <label class="instrument-slider">
                      <span class="instrument-slider-head mono">Capacitor 2 <span class="instrument-slider-val" data-c2-read>160&deg;</span></span>
                      <input type="range" data-c2 min="0" max="180" step="1" value="160" aria-label="Capacitor 2 position, degrees" />
                    </label>
                    <div class="instrument-actions">
                      <button type="button" class="instrument-btn instrument-btn-primary" data-autotune aria-pressed="false">Auto-tune</button>
                      <button type="button" class="instrument-btn" data-detune>Detune</button>
                    </div>
                  </div>
                </div>
              </div>
              <p class="sr-only" data-live role="status" aria-live="polite"></p>
            </aside>
          </div>
          <p class="project-group-label mono">Engineering projects</p>
          <a class="project-card project-card--priority" href="project-vehicle.html" data-fx="sched">
            <span class="fx-sched" aria-hidden="true">
              <span class="fx-sched-bar"><i data-task="PID"></i><i data-task="UART"></i><i data-task="LCD"></i><i data-task="IDLE"></i></span>
            </span>
            <ProjectCover project={projects.vehicle} />
            <ProjectCardCopy project={projects.vehicle} />
          </a>
          <a class="project-card project-card--priority" href="project-robot.html" data-fx="cv">
            <ProjectCover project={projects.robot} />
            <span class="fx-layer" aria-hidden="true">
              <span class="fx-cvbox"><span class="fx-cvlabel">Detected 0.91</span></span>
            </span>
            <ProjectCardCopy project={projects.robot} />
          </a>
          <p class="project-group-label mono">Independent builds</p>
          <a class="project-card project-card--companion" href="project-companion.html" data-fx="swap">
            <ProjectCover project={projects.companion} class="card-img-default" />
            <picture class="card-img-hover">
              <source type="image/webp" srcset="/assets/projects/companion/hover.webp" />
              <img src="/assets/projects/companion/hover.jpg" alt="Kirby Companion embedded device with its touch display active" width="1528" height="1029" loading="lazy" fetchpriority="low" />
            </picture>
            <ProjectCardCopy project={projects.companion} />
          </a>
          <a class="project-card project-card--keychain" href="project-keychain.html" data-fx="chase">
            <ProjectCover project={projects.keychain} class="card-img-default" />
            <picture class="fx-frame"><source type="image/webp" srcset="/assets/projects/keychain/led-1.webp" /><img src="/assets/projects/keychain/led-1.jpg" alt="" aria-hidden="true" width="800" height="800" loading="lazy" fetchpriority="low" /></picture>
            <picture class="fx-frame"><source type="image/webp" srcset="/assets/projects/keychain/led-2.webp" /><img src="/assets/projects/keychain/led-2.jpg" alt="" aria-hidden="true" width="800" height="800" loading="lazy" fetchpriority="low" /></picture>
            <picture class="fx-frame"><source type="image/webp" srcset="/assets/projects/keychain/led-3.webp" /><img src="/assets/projects/keychain/led-3.jpg" alt="" aria-hidden="true" width="800" height="800" loading="lazy" fetchpriority="low" /></picture>
            <picture class="fx-frame"><source type="image/webp" srcset="/assets/projects/keychain/led-4.webp" /><img src="/assets/projects/keychain/led-4.jpg" alt="" aria-hidden="true" width="800" height="800" loading="lazy" fetchpriority="low" /></picture>
            <picture class="fx-frame"><source type="image/webp" srcset="/assets/projects/keychain/led-5.webp" /><img src="/assets/projects/keychain/led-5.jpg" alt="" aria-hidden="true" width="800" height="800" loading="lazy" fetchpriority="low" /></picture>
            <ProjectCardCopy project={projects.keychain} />
          </a>
        </div>
      </section>
      <section class="shell" id="career">
        <div class="section-head" data-address="0x0300">
          <span class="mono">Selected experience</span>
          <h2 class="section-title">Selected engineering experience.</h2>
        </div>
        <div class="timeline">
          <article class="role">
            <div class="role-meta">
              <span class="logo-mark"><img src="/assets/logos/ford.png" alt="Ford Motor Company logo" width="96" height="96" loading="lazy" /></span>
              <time>May 2026 &mdash; Aug 2026</time>
              <span class="org">Ford Motor Company</span>
            </div>
            <div>
              <h3>Hardware Systems Intern</h3>
              <p>Delivered EV hardware integration across three vehicle programs ahead of schedule, resolving voltage-drop issues and specification gaps across 50+ underbody requirements while driving component cost optimization and earning a return offer from Ford&rsquo;s eBeam group.</p>
            </div>
          </article>
          <article class="role">
            <div class="role-meta">
              <span class="logo-mark"><img src="/assets/logos/hacker-fab.png" alt="CMU Hacker Fab logo" width="200" height="200" loading="lazy" /></span>
              <time>Jan 2026 &mdash; Present</time>
              <span class="org">CMU Hacker Fab</span>
            </div>
            <div>
              <h3>Embedded Systems Researcher</h3>
              <p>Built an open-source automated RF matcher for $636 that sustains ~1.2 VSWR at 95W forward power for 60+ minute depositions, using real-time coordinate descent on a Teensy 4.1 to drive air-variable capacitors via a shielded custom PCB.</p>
            </div>
          </article>
          <article class="role">
            <div class="role-meta">
              <span class="logo-mark"><img src="/assets/logos/cmu.png" alt="Carnegie Mellon logo" width="96" height="96" loading="lazy" /></span>
              <time>Jan 2026 &mdash; Present</time>
              <span class="org">Carnegie Mellon University</span>
            </div>
            <div>
              <h3>Embedded Systems Teaching Assistant</h3>
              <p>Guide 60+ students through preemptive RTOS debugging with GDB and OpenOCD, STM32 register-level firmware and serial peripherals, and end-to-end autonomous vehicle bring-up from 2-layer PCB reviews through PID tuning and assembly.</p>
            </div>
          </article>
          <article class="role">
            <div class="role-meta">
              <span class="logo-mark"><img src="/assets/logos/ford.png" alt="Ford Motor Company logo" width="96" height="96" loading="lazy" /></span>
              <time>June 2025 &mdash; Aug 2025</time>
              <span class="org">Ford Motor Company</span>
            </div>
            <div>
              <h3>Vehicle Hardware Intern</h3>
              <p>Resolved a 5.8V drop across an EV control unit through schematic review and corrective hardware proposals, cleared 10+ specification misalignments across three programs auditing 50+ requirements, and delivered a 5% cost reduction on key underbody components.</p>
            </div>
          </article>
        </div>
      </section>
  </main>
  <SiteFooter home />
  <script src="../scripts/home-entry.js"></script>
  <script src="../scripts/live-counters.js"></script>
  <script is:inline type="module" src="/js/instrument-loader.js"></script>
</BaseLayout>
