---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ProjectCover from "../components/ProjectCover.astro";
import WorkshopHero from "../components/WorkshopHero.astro";
import SelectedWork from "../components/SelectedWork.astro";
import { projects } from "../data/projects";
import { Image, Picture } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import companionHover from "../assets/companion-hover.jpg";
import keychainLed1 from "../assets/keychain-led-1.jpg";
import keychainLed2 from "../assets/keychain-led-2.jpg";
import keychainLed3 from "../assets/keychain-led-3.jpg";
import keychainLed4 from "../assets/keychain-led-4.jpg";
import keychainLed5 from "../assets/keychain-led-5.jpg";
import keychainBack from "../assets/keychain-back-fine-grain.jpg";
import cmuLogo from "../assets/logo-cmu.png";
import fordLogo from "../assets/logo-ford.png";
import hackerFabLogo from "../assets/logo-hacker-fab.png";
import "../styles/home.css";
import "../styles/workshop-stage.css";
import "../styles/matcher-exhibit.css";
import "../styles/bench-craft.css";
import { site } from "../data/site";

const keychainFrames = [keychainLed1, keychainLed2, keychainLed3, keychainLed4, keychainLed5];
const origin = Astro.site;
if (!origin) throw new Error("Astro.site must be configured");
const home = new URL("/", origin).href;
const socialImage = new URL(site.socialImage, origin).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${home}#website`, url: home, name: site.name, description: site.description, publisher: { "@id": `${home}#person` } },
    { "@type": "Person", "@id": `${home}#person`, name: site.name, url: home, image: socialImage, email: site.email, jobTitle: "Electrical and Computer Engineer", memberOf: { "@type": "CollegeOrUniversity", name: "Carnegie Mellon University" }, sameAs: ["https://www.linkedin.com/in/msalvacion/", "https://github.com/miguel-salv"] }
  ]
};
---
<BaseLayout
  title="Miguel Salvacion | Electrical and Computer Engineer"
  description="Miguel Salvacion is an electrical and computer engineer at Carnegie Mellon building embedded systems: EV hardware, firmware, PCB design, and RF automation."
  socialDescription={site.description}
  canonical="/"
  structuredData={structuredData}
  headScript="home"
  bodyClass="home-story"
>
  <SiteHeader variant="home" />
  <main id="main" tabindex="-1">
<WorkshopHero />
<SelectedWork />
      <section id="projects" class="bay-builds">
        <div class="shell projects-intro">
          <div class="section-head">
            <h2 class="section-title kirby-title">
              Two Kirbys.
              <svg class="kirby-star" viewBox="0 0 64 54" aria-hidden="true" focusable="false">
                <path class="kirby-star-main" d="m28 5 7 13 15 3-11 11 1 15-14-7-14 6 3-15L4 19l16-2Z" />
                <path class="kirby-star-spark" d="M56 4v12m-6-6h12m-6 28v8m-4-4h8" />
              </svg>
            </h2>
            <p class="workshop-builds-intro">I made both as gifts. One has a touchscreen. The other gets by with a 555 timer.</p>
          </div>
        </div>
        <div class="shell projects-rest">
          <div class="projects-grid">
          <div class="workshop-play-build">
          <a class="project-card project-card--companion project-card--personal" href="project-companion.html" data-fx="swap" data-cinematic-card>
            <span class="cinematic-card-scan" data-cinematic-card-scan aria-hidden="true"></span>
            <ProjectCover project={projects.companion} class="card-img-default" />
            <Picture src={companionHover} pictureAttributes={{ class: "card-img-hover" }} formats={["avif", "webp"]} widths={[480, 640, 760, 960, 1200, 1528]} sizes="(max-width: 760px) 100vw, 50vw" alt="Kirby Companion embedded device with its touch display active" loading="lazy" decoding="async" fetchpriority="low" />
            <div class="project-copy"><span class="workshop-build-meta">ESP32-S3 · 2 weeks</span><h3>Kirby Companion</h3><p>A touchscreen Kirby for the desk with Wi-Fi and I²S audio. I printed the shell and painted the feet by hand.</p><span class="workshop-card-action">View project <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></div>
          </a>
          <button class="workshop-play-button" type="button" data-workshop-companion aria-pressed="false">Wake up Kirby<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v8M6.3 5.8a8 8 0 1 0 11.4 0" /></svg></button>
          </div>
          <div class="workshop-play-build">
          <button class="workshop-play-button workshop-flip-button" type="button" data-workshop-flip aria-pressed="false" hidden>Flip the board<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9h17m-4-4 4 4-4 4m5 2H4m4-4-4 4 4 4" /></svg></button>
          <div class="keychain-hotspot-layer">
            <button class="keychain-switch" type="button" data-workshop-switch aria-label="Press the keychain switch to run the LED chase">
              <span aria-hidden="true">Press me</span>
            </button>
          </div>
          <a class="project-card project-card--keychain project-card--personal" href="project-keychain.html" data-fx="chase" data-cinematic-card>
            <span class="cinematic-card-scan" data-cinematic-card-scan aria-hidden="true"></span>
            <div class="keychain-art">
              <div class="keychain-board">
                <div class="keychain-board-front">
                  <ProjectCover project={projects.keychain} class="card-img-default" />
                  {keychainFrames.map((frame) => <Picture src={frame} pictureAttributes={{ class: "fx-frame", "aria-hidden": "true" }} formats={["avif", "webp"]} widths={[480, 640, 800]} sizes="(max-width: 760px) 100vw, 50vw" alt="" loading="lazy" decoding="async" fetchpriority="low" />)}
                </div>
                <Picture src={keychainBack} pictureAttributes={{ class: "keychain-board-back", "aria-hidden": "true" }} formats={["avif", "webp"]} widths={[480, 760, 960]} sizes="(max-width: 760px) calc(100vw - 48px), 50vw" alt="Back of the purple Kirby keychain, with a coin cell on the left and a black pushbutton on the right." loading="lazy" decoding="async" fetchpriority="low" />
              </div>
              <span class="keychain-board-label" aria-hidden="true">Back of board</span>
            </div>
            <div class="project-copy">
              <span class="workshop-build-meta">Custom PCB · 3 weeks</span>
              <h3>Kirby LED Keychain</h3>
              <div class="keychain-copy">
                <p class="keychain-front-copy">A 555 timer runs the light show. I put the parts on the back so the front could just be Kirby.</p>
                <p class="keychain-back-copy">All the boring stuff goes back here.</p>
              </div>
              <span class="workshop-card-action">View project <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
            </div>
          </a>
          <button class="workshop-play-button" type="button" data-workshop-chase aria-pressed="false">Run the LED chase<span class="bench-leds" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 10 7-10 7V5Z" /></svg></button>
          </div>
          </div>
          <p class="sr-only" data-workshop-play-status role="status" aria-live="polite"></p>
        </div>
      </section>
      <section class="bay-about" id="about" data-cinematic-about>
        <div class="shell story-about">
        <div class="story-about-copy">
        <h2 data-cinematic-about-heading>I’m Miguel.</h2>
        <p data-cinematic-about-body>I design electronics and write firmware, then build and test the whole device. At Carnegie Mellon, I work on RF matching at Hacker Fab and help teach register-level embedded systems.</p>
        <nav class="hero-contact" aria-label="Contact links" data-cinematic-about-contact><a href="mailto:msalvacion@cmu.edu">Email</a><a href="https://www.linkedin.com/in/msalvacion/" target="_blank" rel="noopener">LinkedIn</a><a href="https://github.com/miguel-salv" target="_blank" rel="noopener">GitHub</a></nav>
        <a class="workshop-link site-story-link" href="/about-site/">How I built this site<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
        </div>
        <div class="story-about-portrait portrait-card portrait-card--photo">
          <Picture src={portrait} formats={["webp"]} widths={[320, 480, 768, 1200]} sizes="(min-width: 901px) 40vw, 90vw" alt="Miguel Salvacion" loading="lazy" decoding="async" />
          <button class="portrait-hornet" type="button" aria-label="Lift the Hornet sticker" title="Tap or drag to lift the sticker" disabled>
            <svg class="hornet-art" viewBox="0 0 96 112" aria-hidden="true" focusable="false">
              <defs>
                <path id="hornet-cloak" d="M33 44c6-3 14-3 20 0 1 16 14 33 32 46 2 2 1 4-2 4-10-1-18 0-26 5-5-2-12-1-17 3-7-6-15-6-24-4-2 0-3-2-1-4 11-16 17-34 18-50Z" />
                <path id="hornet-mask" d="M13 8c8 14 18 21 28 21S62 20 72 7c2 19-3 37-15 47-5 5-11 7-18 6C20 58 9 38 13 8Z" />
                <clipPath id="hornet-cloak-clip"><use href="#hornet-cloak" /></clipPath>
                <linearGradient id="hornet-red" x1="25" y1="57" x2="65" y2="103" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#c1364c" />
                  <stop offset="1" stop-color="#8d203b" />
                </linearGradient>
                <linearGradient id="hornet-fold-light" x1="26" y1="78" x2="43" y2="83" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#e06772" stop-opacity=".82" />
                  <stop offset="1" stop-color="#e06772" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="hornet-fold-shadow" x1="54" y1="80" x2="72" y2="74" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#54132b" stop-opacity=".64" />
                  <stop offset="1" stop-color="#54132b" stop-opacity=".1" />
                </linearGradient>
                <linearGradient id="hornet-neck-shadow" x1="44" y1="53" x2="44" y2="69" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#54132b" stop-opacity=".46" />
                  <stop offset="1" stop-color="#54132b" stop-opacity="0" />
                </linearGradient>
              </defs>
              <use href="#hornet-mask" fill="#fbf7ec" stroke="#fbf7ec" stroke-width="7" stroke-linejoin="round" />
              <g class="hornet-cloak">
                <use href="#hornet-cloak" fill="#fbf7ec" stroke="#fbf7ec" stroke-width="7" stroke-linejoin="round" />
                <g clip-path="url(#hornet-cloak-clip)">
                  <use href="#hornet-cloak" fill="url(#hornet-red)" />
                  <path fill="url(#hornet-fold-light)" d="M35 48c5 17 1 34-12 50l12 1c11-15 12-33 6-51Z" />
                  <path fill="url(#hornet-fold-shadow)" d="M48 47c1 15 7 28 13 37 4 5 6 11 5 16l14-4c-4-7-10-12-16-19-6-10-9-20-10-30Z" />
                  <use href="#hornet-cloak" fill="url(#hornet-neck-shadow)" />
                  <use class="hornet-cloak-ink" href="#hornet-cloak" fill="#ef7890" opacity="0" />
                </g>
                <use href="#hornet-cloak" fill="none" stroke="#38262b" stroke-width="2" stroke-linejoin="round" />
              </g>
              <use href="#hornet-mask" fill="#fbf0df" stroke="#38262b" stroke-width="2" stroke-linejoin="round" />
              <path fill="#30232a" d="M22 34c7 1 12 7 13 15-7 1-13-5-13-15Zm38-3c1 8-4 16-11 17 0-8 4-14 11-17Z" />
            </svg>
          </button>
        </div>
        <div class="skill-marquee" role="group" aria-label="Technical skills">
          <div class="skill-track">
            <div class="skill-set">
              <span>PCB Design</span><span>Power Delivery</span><span>C / C++</span><span>ARM Assembly</span><span>STM32</span><span>Zephyr RTOS</span><span>CAN</span><span>I2C / SPI / UART</span><span>Python</span><span>RF Automation</span><span>Hardware Debugging</span><span>SolidWorks</span>
            </div>
            <div class="skill-set" aria-hidden="true">
              <span>PCB Design</span><span>Power Delivery</span><span>C / C++</span><span>ARM Assembly</span><span>STM32</span><span>Zephyr RTOS</span><span>CAN</span><span>I2C / SPI / UART</span><span>Python</span><span>RF Automation</span><span>Hardware Debugging</span><span>SolidWorks</span>
            </div>
          </div>
        </div>
        </div>
      </section>
      <section class="bay-career" id="career" data-cinematic-career>
        <div class="shell">
        <div class="section-head">
          <h2 class="section-title">Experience.</h2>
        </div>
        <div class="timeline">
          <article class="role" data-cinematic-role>
            <div class="role-meta">
              <span class="logo-mark" data-cinematic-role-logo><Image src={fordLogo} alt="Ford Motor Company logo" width={46} height={46} densities={[1, 2]} loading="lazy" decoding="async" /></span>
              <time datetime="2025-05">Summer 2025 &amp; 2026</time>
              <span class="org">Ford Motor Company</span>
            </div>
            <div class="role-copy" data-cinematic-role-copy>
              <h3>Hardware Systems Engineering Intern</h3>
              <p class="role-outcome">Resolved a 5.8 V control-unit voltage drop in EV power delivery.</p>
            <details class="role-details">
              <summary>Role details<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg></summary>
              <p>On eDrive Units Diagnostics, resolved a 5.8 V control-unit drop from heat and undersized wiring, then specified upgraded gauges and routing. Isolated a Mach-E/E-Transit park-system ratcheting fault from warranty teardowns, presented an 8D, and wrote EDU service procedures that validated modular eMotor repair over full-unit replacements.</p>
            </details>
            </div>
          </article>
          <article class="role" data-cinematic-role>
            <div class="role-meta">
              <span class="logo-mark" data-cinematic-role-logo><Image src={hackerFabLogo} alt="CMU Hacker Fab logo" width={46} height={46} densities={[1, 2]} loading="lazy" decoding="async" /></span>
              <time datetime="2026-01">Jan 2026 &mdash; Present</time>
              <span class="org">CMU Hacker Fab</span>
            </div>
            <div class="role-copy" data-cinematic-role-copy>
              <h3>Embedded Systems Researcher</h3>
              <p class="role-outcome">Built a $636 RF matcher that holds ~1.2 VSWR at 95&ndash;100 W.</p>
            <details class="role-details">
              <summary>Role details<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg></summary>
              <p>Built an open-source automated RF matcher for $636 (80%+ below commercial units) that holds ~1.2 VSWR at 95&ndash;100 W for 60+ minute depositions, using real-time coordinate descent on a Teensy 4.1 and a KiCad control PCB whose SWR and protection paths were checked in ngspice so ADC inputs stay below 3.3 V.</p>
            </details>
            </div>
          </article>
          <article class="role" data-cinematic-role>
            <div class="role-meta">
              <span class="logo-mark" data-cinematic-role-logo><Image src={cmuLogo} alt="Carnegie Mellon logo" width={46} height={46} densities={[1, 2]} loading="lazy" decoding="async" /></span>
              <time datetime="2026-01">Jan 2026 &mdash; Present</time>
              <span class="org">Carnegie Mellon University</span>
            </div>
            <div class="role-copy" data-cinematic-role-copy>
              <h3>Head Teaching Assistant</h3>
              <p class="role-outcome">Manage 10 TAs and mentor 60+ students in embedded systems.</p>
            <details class="role-details">
              <summary>Role details<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg></summary>
              <p>Manage 10 TAs and mentor 60+ students debugging custom preemptive RTOS kernels&mdash;PendSV context-switch faults, RMS bugs, and HLP priority inversion&mdash;using GDB and OpenOCD over JTAG. Guide STM32 firmware (MMIO, interrupt-driven serial, PWM) and review student 2-layer PCBs through PID motor tuning and sensor-actuator bring-up.</p>
            </details>
            </div>
          </article>
        </div>
        </div>
      </section>
  </main>
  <SiteFooter home />
  <script src="../scripts/home-entry.js"></script>
  <script src="../scripts/instrument-loader.js"></script>
</BaseLayout>
