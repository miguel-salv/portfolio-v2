---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PortfolioData from "../components/PortfolioData.astro";
import ProjectCover from "../components/ProjectCover.astro";
import WorkshopHero from "../components/WorkshopHero.astro";
import SelectedWork from "../components/SelectedWork.astro";
import { projects } from "../data/projects";
import { Image, Picture } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import companionHover from "../assets/companion-hover.jpg";
import keychainLed1 from "../assets/keychain-led-1.jpg";
import keychainLed2 from "../assets/keychain-led-2.jpg";
import keychainLed3 from "../assets/keychain-led-3.jpg";
import keychainLed4 from "../assets/keychain-led-4.jpg";
import keychainLed5 from "../assets/keychain-led-5.jpg";
import cmuLogo from "../assets/logo-cmu.png";
import fordLogo from "../assets/logo-ford.png";
import hackerFabLogo from "../assets/logo-hacker-fab.png";
import "../styles/home.css";
import "../styles/workshop-stage.css";
import "../styles/matcher-exhibit.css";
import { site } from "../data/site";

const keychainFrames = [keychainLed1, keychainLed2, keychainLed3, keychainLed4, keychainLed5];
const origin = Astro.site;
if (!origin) throw new Error("Astro.site must be configured");
const home = new URL("/", origin).href;
const socialImage = new URL(site.socialImage, origin).href;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${home}#website`, url: home, name: site.name, description: site.description, publisher: { "@id": `${home}#person` } },
    { "@type": "Person", "@id": `${home}#person`, name: site.name, url: home, image: socialImage, email: site.email, jobTitle: "Electrical and Computer Engineer", memberOf: { "@type": "CollegeOrUniversity", name: "Carnegie Mellon University" }, sameAs: ["https://www.linkedin.com/in/msalvacion/", "https://github.com/miguel-salv"] }
  ]
};
---
<BaseLayout
  title="Miguel Salvacion | Electrical and Computer Engineer"
  description="Miguel Salvacion is an electrical and computer engineer at Carnegie Mellon building embedded systems: EV hardware, firmware, PCB design, and RF automation."
  socialDescription={site.description}
  canonical="/"
  structuredData={structuredData}
  headScript="home"
  bodyClass="home-story"
>
  <PortfolioData />
  <SiteHeader variant="home" />
  <main id="main" tabindex="-1">
<WorkshopHero />
<SelectedWork />
      <section id="projects" class="bay-builds">
        <div class="shell projects-intro">
          <div class="section-head">
            <h2 class="section-title">Serious circuits.<br /><em>A playful streak.</em></h2>
<p class="workshop-builds-intro">Sometimes the brief is simply to make something that makes you smile.</p>
          </div>
        </div>
        <div class="shell projects-rest">
          <div class="projects-grid">
          <div class="workshop-play-build">
          <a class="project-card project-card--companion project-card--personal" href="project-companion.html" data-fx="swap" data-cinematic-card>
            <span class="cinematic-card-scan" data-cinematic-card-scan aria-hidden="true"></span>
            <ProjectCover project={projects.companion} class="card-img-default" priority />
            <Picture src={companionHover} pictureAttributes={{ class: "card-img-hover" }} formats={["avif", "webp"]} widths={[480, 640, 760, 960, 1200, 1528]} sizes="(max-width: 760px) 100vw, 50vw" alt="Kirby Companion embedded device with its touch display active" loading="lazy" decoding="async" fetchpriority="low" />
            <div class="project-copy"><h3>Kirby Companion</h3><p>A touch display, Wi-Fi, audio, and a custom enclosure. A small friend with a lot going on.</p><span class="workshop-build-meta">ESP32-S3 · Independent build · 2 weeks</span><span class="workshop-card-action">Meet the companion <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></div>
          </a>
          <button class="workshop-play-button" type="button" data-workshop-companion aria-pressed="false">Wake up Kirby<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v8M6.3 5.8a8 8 0 1 0 11.4 0" /></svg></button>
          </div>
          <div class="workshop-play-build">
          <a class="project-card project-card--keychain project-card--personal" href="project-keychain.html" data-fx="chase" data-cinematic-card>
            <span class="cinematic-card-scan" data-cinematic-card-scan aria-hidden="true"></span>
            <ProjectCover project={projects.keychain} class="card-img-default" priority />
            {keychainFrames.map((frame) => <Picture src={frame} pictureAttributes={{ class: "fx-frame", "aria-hidden": "true" }} formats={["avif", "webp"]} widths={[480, 640, 800]} sizes="(max-width: 760px) 100vw, 50vw" alt="" loading="eager" decoding="async" fetchpriority="low" />)}
            <div class="project-copy"><h3>Kirby LED Keychain</h3><p>A tiny analog circuit with a bright personality. No microcontroller, just a 555 timer and a little choreography.</p><span class="workshop-build-meta">Custom PCB · Independent build · 3 weeks</span><span class="workshop-card-action">Follow the lights <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span></div>
          </a>
          <button class="workshop-play-button" type="button" data-workshop-chase aria-pressed="false">Run the LED chase<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 10 7-10 7V5Z" /></svg></button>
          </div>
          </div>
          <p class="sr-only" data-workshop-play-status role="status" aria-live="polite"></p>
        </div>
      </section>
      <section class="bay-about" id="about" data-cinematic-about>
        <div class="shell story-about">
        <div class="story-about-copy">
        <h2 data-cinematic-about-heading>A hands-on mind.<br /><em>A human side.</em></h2>
        <p data-cinematic-about-body>Improved EV power delivery at Ford, deployed automated RF matching at Hacker Fab, taught register-level embedded systems, and built independent devices where the enclosure, PCB, and interface have to work together.</p>
        <nav class="hero-contact" aria-label="Contact links" data-cinematic-about-contact><a href="mailto:msalvacion@cmu.edu">Email</a><a href="https://www.linkedin.com/in/msalvacion/" target="_blank" rel="noopener">LinkedIn</a><a href="https://github.com/miguel-salv" target="_blank" rel="noopener">GitHub</a></nav>
        </div>
        <div class="story-about-portrait portrait-card portrait-card--photo">
          <Picture src={portrait} formats={["webp"]} widths={[320, 480, 768, 1200]} sizes="(min-width: 901px) 40vw, 90vw" alt="Miguel Salvacion" loading="lazy" decoding="async" />
        </div>
        <div class="skill-marquee" aria-label="Technical skills">
          <div class="skill-track">
            <div class="skill-set">
              <span>PCB Design</span><span>Power Delivery</span><span>C / C++</span><span>ARM Assembly</span><span>STM32</span><span>Zephyr RTOS</span><span>CAN</span><span>I2C / SPI / UART</span><span>Python</span><span>RF Automation</span><span>Hardware Debugging</span><span>SolidWorks</span>
            </div>
            <div class="skill-set" aria-hidden="true">
              <span>PCB Design</span><span>Power Delivery</span><span>C / C++</span><span>ARM Assembly</span><span>STM32</span><span>Zephyr RTOS</span><span>CAN</span><span>I2C / SPI / UART</span><span>Python</span><span>RF Automation</span><span>Hardware Debugging</span><span>SolidWorks</span>
            </div>
          </div>
        </div>
        </div>
      </section>
      <section class="bay-career" id="career" data-cinematic-career>
        <div class="shell">
        <div class="section-head">
          <h2 class="section-title">Built with <em>people.</em></h2>
        </div>
        <div class="timeline">
          <article class="role" data-cinematic-role>
            <div class="role-meta">
              <span class="logo-mark" data-cinematic-role-logo><Image src={fordLogo} alt="Ford Motor Company logo" width={46} height={46} densities={[1, 2]} loading="lazy" decoding="async" /></span>
              <time datetime="2025-05">Summer 2025 &amp; 2026</time>
              <span class="org">Ford Motor Company</span>
            </div>
            <details class="role-details" data-cinematic-role-copy>
              <summary><h3>Hardware Systems Engineering Intern</h3><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg></summary>
              <p>On eDrive Units Diagnostics, resolved a 5.8 V control-unit drop from heat and undersized wiring, then specified upgraded gauges and routing. Isolated a Mach-E/E-Transit park-system ratcheting fault from warranty teardowns, presented an 8D, and wrote EDU service procedures that validated modular eMotor repair over full-unit replacements.</p>
            </details>
          </article>
          <article class="role" data-cinematic-role>
            <div class="role-meta">
              <span class="logo-mark" data-cinematic-role-logo><Image src={hackerFabLogo} alt="CMU Hacker Fab logo" width={46} height={46} densities={[1, 2]} loading="lazy" decoding="async" /></span>
              <time datetime="2026-01">Jan 2026 &mdash; Present</time>
              <span class="org">CMU Hacker Fab</span>
            </div>
            <details class="role-details" data-cinematic-role-copy>
              <summary><h3>Embedded Systems Researcher</h3><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg></summary>
              <p>Built an open-source automated RF matcher for $636 (80%+ below commercial units) that holds ~1.2 VSWR at 95&ndash;100 W for 60+ minute depositions, using real-time coordinate descent on a Teensy 4.1 and a KiCad control PCB whose SWR and protection paths were checked in ngspice so ADC inputs stay below 3.3 V.</p>
            </details>
          </article>
          <article class="role" data-cinematic-role>
            <div class="role-meta">
              <span class="logo-mark" data-cinematic-role-logo><Image src={cmuLogo} alt="Carnegie Mellon logo" width={46} height={46} densities={[1, 2]} loading="lazy" decoding="async" /></span>
              <time datetime="2026-01">Jan 2026 &mdash; Present</time>
              <span class="org">Carnegie Mellon University</span>
            </div>
            <details class="role-details" data-cinematic-role-copy>
              <summary><h3>Head Teaching Assistant</h3><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg></summary>
              <p>Manage 10 TAs and mentor 60+ students debugging custom preemptive RTOS kernels&mdash;PendSV context-switch faults, RMS bugs, and HLP priority inversion&mdash;using GDB and OpenOCD over JTAG. Guide STM32 firmware (MMIO, interrupt-driven serial, PWM) and review student 2-layer PCBs through PID motor tuning and sensor-actuator bring-up.</p>
            </details>
          </article>
        </div>
        </div>
      </section>
  </main>
  <SiteFooter home />
  <script src="../scripts/home-entry.js"></script>
  <script src="../scripts/instrument-loader.js"></script>
</BaseLayout>
