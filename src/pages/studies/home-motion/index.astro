---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import WorkshopHero from '../../../components/WorkshopHero.astro';
import StudyMatcherPanel from '../../../components/studies/StudyMatcherPanel.astro';
import StudyPersonalBuilds from '../../../components/studies/StudyPersonalBuilds.astro';
import {Picture} from 'astro:assets';
import portrait from '../../../assets/portrait.jpg';
import '../../../styles/home.css';
import '../../../styles/matcher-exhibit.css';
import '../../../styles/studies/home-motion.css';
---
<BaseLayout title="Miguel Salvacion — Motion study" description="An isolated visual study of Miguel’s hardware, firmware, and personal builds." canonical="/studies/home-motion/" robots="noindex,nofollow" headScript="home" bodyClass="home-story home-motion-study">
  <SiteHeader variant="fallback" />
  <main id="main" tabindex="-1">
    <div class="study-sequence" data-home-motion>
      <div class="study-stage" data-study-stage>
        <WorkshopHero />
        <div class="study-surface" data-study-surface aria-hidden="true" hidden>
          <canvas></canvas>
          <div class="study-live" data-study-live hidden></div>
          <div class="study-markers">
            <button type="button" data-study-marker="capacitors" tabindex="-1" aria-label="Select air capacitors"><span></span></button>
            <button type="button" data-study-marker="motors" tabindex="-1" aria-label="Select stepper motors"><span></span></button>
            <button type="button" data-study-marker="control" tabindex="-1" aria-label="Select controller and display"><span></span></button>
          </div>
        </div>
        <section class="study-chapter study-matcher" id="project-matcher" data-study-chapter="matcher" aria-label="Automated impedance matcher">
          <figure class="study-flow-seat" data-study-seat="matcher">
            <picture><source media="(max-width:760px)" srcset="/assets/studies/home-motion/hero-push-phone-0048.webp" /><img src="/assets/studies/home-motion/hero-push-landscape-0048.webp" alt="The same impedance matcher, seen closer on its laboratory bench" width="1920" height="1200" loading="lazy" /></picture>
            <figcaption>Rendered reconstruction · actual CAD and project photographs</figcaption>
          </figure>
          <div class="study-copy"><StudyMatcherPanel /></div>
        </section>
        <section class="study-chapter study-vehicle" id="project-vehicle" data-study-chapter="vehicle" aria-labelledby="study-vehicle-title">
          <figure class="study-flow-seat" data-study-seat="vehicle">
            <picture><source media="(max-width:760px)" srcset="/assets/studies/home-motion/shaft-to-drive-portrait-0088.webp" /><img src="/assets/studies/home-motion/shaft-to-drive-landscape-0088.webp" alt="The black and green embedded vehicle moving on a laboratory floor, with red wheels and its custom controller" width="1920" height="1200" loading="lazy" /></picture>
            <figcaption>Rendered reconstruction · motion is illustrative</figcaption>
          </figure>
          <div class="study-copy">
            <h2 id="study-vehicle-title">Real-time<br />means on time.</h2>
            <p class="study-project-name">Real-Time Embedded Vehicle</p>
            <p>I built the RTOS kernel, carrier PCB, device drivers, and closed-loop motor control around an STM32 Cortex-M4.</p>
            <p class="study-vehicle-measure"><span>&lt;10%</span> average wheel-speed error, measured through encoder telemetry.</p>
            <div class="study-evidence-links">
              <a href="/project-vehicle.html#demo-vehicle-rtos">Try the real-time scheduler <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
              <a href="/project-vehicle.html">Explore the project</a>
              <a href="/assets/projects/vehicle/cover.jpg" target="_blank" rel="noopener">Actual hardware photograph</a>
            </div>
          </div>
        </section>
        <section class="study-chapter study-robot" id="project-robot" data-study-chapter="robot" aria-labelledby="study-robot-title">
          <figure class="study-flow-seat" data-study-seat="robot">
            <picture><source media="(max-width:760px)" srcset="/assets/studies/home-motion/bottle-collect-portrait-0119.webp" /><img src="/assets/studies/home-motion/bottle-collect-landscape-0119.webp" alt="The autonomous collection robot approaching a bottle on a photograph-referenced tiled floor" width="1920" height="1200" loading="lazy" /></picture>
            <figcaption>Rendered reconstruction · modeled sensing and collection</figcaption>
          </figure>
          <div class="study-copy">
            <h2 id="study-robot-title">See it.<br /> Go get it.</h2>
            <p class="study-project-name">Trash Collection Robot · CMU Build18</p>
            <p>I led electronics and power systems, including motor-drive hardware, power delivery, the UART protocol, and hardware–firmware integration.</p>
            <div class="study-robot-operation">
              <p>Modeled sequence</p>
              <ol aria-label="Sensing and collection sequence"><li data-study-operation="detect">Detect</li><li data-study-operation="approach">Approach</li><li data-study-operation="collect">Collect</li></ol>
              <p class="study-command" data-study-command>Camera scans for a bottle.</p>
            </div>
            <div class="study-evidence-links">
              <a href="/project-robot.html#demo-robot-cv">Run the vision pipeline <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
              <a href="/project-robot.html">Explore the project</a>
              <a href="/assets/projects/robot/cover.jpg" target="_blank" rel="noopener">Actual hardware photograph</a>
            </div>
          </div>
        </section>
        <nav class="study-chapters" aria-label="Hardware chapters">
          <a href="#project-matcher" data-scroll-owned data-study-chapter-link="matcher">Matcher</a>
          <a href="#project-vehicle" data-scroll-owned data-study-chapter-link="vehicle">Vehicle</a>
          <a href="#project-robot" data-scroll-owned data-study-chapter-link="robot">Robot</a>
          <a href="#projects">Personal builds <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6" /></svg></a>
        </nav>
        <noscript><p class="shell study-script-note">The project images and technical pages are available without JavaScript. Enable it to explore the camera sequence and interactive tuner.</p></noscript>
      </div>
    </div>
    <StudyPersonalBuilds />
    <section class="study-about shell" id="about" aria-labelledby="study-about-title">
      <div><h2 id="study-about-title">I’m Miguel.</h2><p>I design hardware and write firmware. At Ford, I improved EV power delivery; at Hacker Fab, I deployed automated RF matching. I also teach register-level embedded systems and build my own devices where the enclosure, PCB, and interface have to work together.</p><a class="study-text-link" href="/resume/">Read my resume</a></div>
      <Picture src={portrait} formats={['avif','webp']} widths={[480,768,1200]} sizes="(max-width:760px) 90vw, 40vw" alt="Miguel Salvacion" loading="lazy" />
    </section>
    <p class="study-review-note shell">Visual study. <a href="/">Compare with the current homepage</a>.</p>
  </main>
  <SiteFooter home />
  <script>
    import '../../../scripts/portfolio-core.js';
    import '../../../scripts/portfolio-home.js';
    import '../../../scripts/workshop.js';
    import '../../../scripts/studies/home-motion.js';
  </script>
</BaseLayout>
