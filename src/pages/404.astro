---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/project.css";
import "../styles/workshop-recovery.css";
---
<BaseLayout title="404 | Miguel Salvacion" description="The page you requested could not be found." canonical="/404.html" robots="noindex" bodyClass="fallback-page not-found-page">
  <SiteHeader variant="fallback" />
  <main id="main" class="not-found-main shell" tabindex="-1">
    <div class="not-found-copy">
      <h1>This page<br /> wandered off.</h1>
      <p>We couldn&rsquo;t find that page. The link may have moved or been mistyped. There&rsquo;s still plenty to explore in the workshop.</p>
      <p class="not-found-status">404 &middot; Page not found</p>
      <div class="not-found-actions">
        <a href="/">Back to the workshop<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        <a href="/#project-matcher">Explore the projects<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
      </div>
    </div>
    <figure class="not-found-room" aria-label="Miguel’s matcher CAD assembly and photo-referenced vehicle and robot in the workshop.">
      <img class="not-found-light" src="/assets/workshop/workshop-light.webp" width="1920" height="1200" alt="Miguel’s engineering models on colorful workshop pedestals." loading="eager" decoding="async" />
      <img class="not-found-dark" src="/assets/workshop/workshop-dark.webp" width="1920" height="1200" alt="" aria-hidden="true" loading="lazy" decoding="async" />
      <figcaption>There&rsquo;s more on the workbench.</figcaption>
    </figure>
  </main>
  <SiteFooter />
  <script src="../scripts/portfolio-core.js"></script>
</BaseLayout>
