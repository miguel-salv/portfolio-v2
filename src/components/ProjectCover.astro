---
import { Picture } from "astro:assets";
import type { ProjectMeta } from "../data/projects";
import impedanceCover from "../assets/impedance-cover.jpg";
import vehicleCover from "../assets/vehicle-cover.jpg";
import robotCover from "../assets/robot-cover.jpg";
import companionCover from "../assets/companion-cover.jpg";
import keychainCover from "../assets/keychain-cover.jpg";

interface Props {
  project: ProjectMeta;
  class?: string;
  priority?: boolean;
}

const { project, class: className, priority = false } = Astro.props;
const imageByProject = {
  impedance: impedanceCover,
  vehicle: vehicleCover,
  robot: robotCover,
  companion: companionCover,
  keychain: keychainCover
};
const image = imageByProject[project.id as keyof typeof imageByProject];
const widths = [480, 640, 760, 960, project.hero.image.width];
---
<Picture
  src={image}
  pictureAttributes={{ class: className, "data-project-cover": project.id }}
  formats={["avif", "webp"]}
  widths={widths}
  sizes="(max-width: 760px) 100vw, 50vw"
  alt={project.hero.image.alt}
  loading={priority ? "eager" : "lazy"}
  decoding={priority ? "sync" : "async"}
  fetchpriority={priority ? "high" : "low"}
/>
