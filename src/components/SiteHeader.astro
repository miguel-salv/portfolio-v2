---
import { site } from "../data/site";
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";

interface Props {
  variant?: "home" | "project" | "resume" | "fallback";
}

const { variant = "home" } = Astro.props;
const navLabel = variant === "project" ? "Project navigation" : variant === "resume" ? "Resume navigation" : "Primary navigation";
---
<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header" data-variant={variant} transition:persist="site-header" transition:animate="none">
  <span class="glass-frost" aria-hidden="true"></span>
  <nav class="nav" aria-label={navLabel}>
    <a class="brand" href="/" aria-label="Miguel Salvacion home"><Image src={avatar} alt="" width={30} height={30} densities={[1, 2]} sizes="30px" loading="eager" decoding="async" /><span>{site.name}</span></a>
    <svg class="nav-climb" viewBox="0 0 114 36" aria-hidden="true" focusable="false">
      <path class="nav-climb-route" d="m12 26 25-11 30 6 33-11" />
      <path class="nav-climb-terracotta" d="M3 28c0-2 3-4 5-8 2-3 7-3 9-1 3 2 6 2 6 5-1 5-6 8-11 7-4-1-9 0-9-3Z" />
      <path class="nav-climb-blue" d="M32 19c-2-3-1-7 2-10 2-3 7-4 9-1 2 3-1 6-2 9-1 4-7 6-9 2Z" />
      <path class="nav-climb-gold" d="M56 20c2-3 7-5 11-5 5 0 9 3 10 6 1 3-2 5-5 5-5 0-10-1-14-1-2 0-3-2-2-5Z" />
      <path class="nav-climb-terracotta" d="M90 12c2-2 3-5 5-7 2-2 4-1 7 0 3 0 7 0 8 3s-3 5-4 8c-2 3-7 2-9 1-3-1-8-1-7-5Z" />
      <g class="nav-climb-bolts">
        <circle cx="12" cy="26" r="1.4" /><circle cx="37" cy="15" r="1.4" />
        <circle cx="67" cy="21" r="1.4" /><circle cx="100" cy="10" r="1.4" />
      </g>
      <circle class="nav-climb-marker" cx="12" cy="26" r="2" />
    </svg>
    <ul class="nav-links" id="nav-links" role="list">
      {site.navigation.map((item) => <li><a data-nav-item={item.label.toLowerCase()} href={variant === "home" && item.href.startsWith("/#") ? item.href.slice(1) : item.href} aria-current={variant === "resume" && item.label === "Resume" ? "page" : variant === "project" && item.label === "Projects" ? "true" : undefined}><span class="nav-label">{item.label}</span></a></li>)}
      <li class="header-selection" aria-hidden="true" role="presentation"></li>
      <li class="nav-search-item">
        <button class="nav-search" type="button" data-nav-search aria-haspopup="dialog">Search</button>
      </li>
    </ul>
    <div class="nav-tools">
      <button class="cmdk-chip icon-btn" type="button" aria-haspopup="dialog" aria-expanded="false" aria-label="Search" data-cmdk-trigger>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="m16 16 3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </button>
      <button class="theme-toggle icon-btn" type="button" aria-pressed="false" aria-label="Switch to dark theme" data-theme-toggle>
        <svg class="theme-icon theme-icon-moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3.5a8.5 8.5 0 1 0 8.5 8.5 6.5 6.5 0 0 1-8.5-8.5Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
        <svg class="theme-icon theme-icon-sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M12 2.75v2.25M12 19v2.25M4.22 4.22l1.59 1.59M18.19 18.19l1.59 1.59M2.75 12h2.25M19 12h2.25M4.22 19.78l1.59-1.59M18.19 5.81l1.59-1.59" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </button>
      <button class="mobile-toggle icon-btn" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Open navigation menu">
        <svg class="menu-icon menu-icon-open" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 7h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><path d="M5 17h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
        <svg class="menu-icon menu-icon-close" aria-hidden="true" viewBox="0 0 24 24"><path d="m6.5 6.5 11 11M17.5 6.5l-11 11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </nav>
</header>
<style>
  .nav-climb { display: none; }
  @media (min-width: 375px) and (forced-colors: none) {
    :global(html[data-surface="home"]) .nav-climb {
      display: block;
      width: clamp(52px, 14vw, 110px);
      height: 34px;
      flex: none;
    }
    .nav-climb-route { fill: none; stroke: var(--rule); stroke-dasharray: 1 3; stroke-linecap: round; }
    .nav-climb-terracotta { fill: #ad543a; }
    .nav-climb-blue { fill: var(--brand); }
    .nav-climb-gold { fill: #aa761d; }
    .nav-climb-bolts { fill: #211914; stroke: none; opacity: .68; }
    .nav-climb-marker { fill: #fff1e8; stroke: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .nav-climb-marker {
        animation: climb-page auto steps(1, end) both;
        animation-timeline: scroll(root block);
      }
    }
  }
  @keyframes climb-page {
    0% { transform: translate(0, 0); }
    25% { transform: translate(25px, -11px); }
    50% { transform: translate(55px, -5px); }
    75%, 100% { transform: translate(88px, -16px); }
  }
</style>
<script>
  const root = document.documentElement;
  if (!root.dataset.navSearchBound) {
    root.dataset.navSearchBound = "true";
    document.addEventListener("click", (event) => {
      const search = event.target instanceof Element ? event.target.closest("[data-nav-search]") : null;
      if (!search) return;
      const chip = document.querySelector(".nav-tools [data-cmdk-trigger]");
      if (!(chip instanceof HTMLElement)) return;
      chip.inert = false;
      chip.click();
    });
  }
</script>
