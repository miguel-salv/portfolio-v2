---
import { projects } from "../data/projects";
import ProjectCover from "./ProjectCover.astro";
import MatcherBench from "./MatcherBench.astro";
const work = [
  { id: "matcher", project: projects.impedance, heading: "Automated impedance matcher", summary: "A closed-loop RF matcher that turns a finicky manual process into repeatable, automated tuning." },
  { id: "vehicle", project: projects.vehicle, heading: "Real-time embedded vehicle", summary: "A custom real-time operating system, a carrier PCB, and PID control. One complete embedded vehicle." },
  { id: "robot", project: projects.robot, heading: "Trash collection robot", summary: "Computer vision meets motor control and custom power delivery in an autonomous collection robot." }
];
---
<section class="workshop-work" aria-labelledby="selected-work-title">
  <div class="shell workshop-section-intro">
    <h2 id="selected-work-title">Things I've<br /><em>made work.</em></h2>
    <p>Three machines. Three different challenges. Follow the hardware, or jump to the one that catches your eye.</p>
  </div>
  <article class="project-journey" data-journey data-intro-end="0" data-matcher-loop data-continuous-loops data-handoff-duration="600" aria-label="Three connected engineering projects">
    <script is:inline>
      (function(root) {
        if (!root) return;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || matchMedia('(max-width: 620px)').matches || matchMedia('(min-width: 621px) and (max-height: 700px)').matches) root.classList.add('is-static');
        root.classList.add('is-enhanced');
      })(document.currentScript && document.currentScript.parentElement);
    </script>
    <div class="project-journey-track" data-journey-track="duplex" data-text-side="left">
      <div class="project-journey-stage">
        <figure class="project-journey-media">
          <span class="journey-artwork-stage" data-journey-stage><span class="journey-artwork-depth" data-journey-depth><span class="journey-artwork-optics" data-journey-optics>
            <img class="project-journey-poster" data-journey-poster src="/assets/stories/moments/matcher-landscape-poster.webp" alt="" width="1440" height="1080" loading="lazy" />
            <video class="project-journey-video" data-journey-video muted playsinline preload="none" aria-hidden="true"></video>
            <video class="project-journey-video" data-journey-video muted playsinline preload="none" aria-hidden="true"></video>
          </span></span></span>
          <figcaption class="sr-only">Impedance matcher, embedded vehicle and collection robot models.</figcaption>
        </figure>
        <nav class="journey-chapters" aria-label="Hardware chapters">
          {work.map((item,index) => <button type="button" data-scene={item.id}><span class="journey-chapter-number">0{index+1}</span>{item.project.mapTitle}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></button>)}
          <button class="journey-motion" type="button" data-journey-motion hidden aria-pressed="false">Pause model motion</button>
          <a href="#projects" class="journey-skip" aria-label="Skip to independent builds">Keep exploring <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M6 14l6 6 6-6" /></svg></a>
        </nav>
        <div class="project-journey-hud">
          {work.map((item,index) => (
            <section class:list={["project-journey-chapter",index===0&&"is-active"]} id={`project-${item.id}`} data-journey-chapter={item.id} data-text-side="left" aria-labelledby={`story-${item.id}-heading`}>
              <figure class="project-journey-still">
                <picture><source media="(max-width: 620px)" srcset={`/assets/stories/moments/${item.id}-portrait-poster.webp`} /><img src={`/assets/stories/moments/${item.id}-landscape-poster.webp`} alt={`Model of the ${item.project.mapTitle.toLowerCase()}.`} width="1440" height="1080" loading="lazy" /></picture>
                <video class="project-journey-loop" data-journey-loop muted playsinline loop preload="none" aria-hidden="true"></video>
              </figure>
              <div class="journey-panel">
                <h3 id={`story-${item.id}-heading`}>{item.heading}</h3>
                <p class="journey-summary">{item.summary}</p>
                <dl class="workshop-results">{item.project.card.metrics.map(metric => <div><dt class="sr-only">Project result</dt><dd>{metric.text}</dd></div>)}</dl>
                <a class="workshop-link" href={item.project.route}>Explore the project<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
                <div class="journey-proof">
                  <a class="project-card workshop-evidence" href={item.project.route.slice(1)}><ProjectCover project={item.project} /><svg class="journey-photo-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg><span class="sr-only">See the actual {item.project.mapTitle.toLowerCase()} build</span></a>
                  <p>{item.project.card.eyebrow}{index===0 && <a href="#instrument-bench">Try the tuner <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>}</p>
                </div>
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </article>
  <div class="shell workshop-tuner-row"><p>Explore the control loop<br /><em>with your own hands.</em></p><MatcherBench /></div>
</section>
