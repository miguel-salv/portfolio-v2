---
import { projects } from "../data/projects";
import JourneyEvidence from "./JourneyEvidence.astro";
import MatcherExhibit from "./MatcherExhibit.astro";
const work = [
  { id: "matcher", project: projects.impedance, heading: "Automated impedance matcher", summary: "A closed-loop RF matcher that automates manual capacitor tuning." },
  { id: "vehicle", project: projects.vehicle, heading: "Real-Time Embedded Vehicle", summary: "An embedded vehicle with a custom preemptive RTOS, carrier PCB, and PID motor control." },
  { id: "robot", project: projects.robot, heading: "Trash Collection Robot", summary: "An autonomous bottle-collection robot with computer vision, motor control, and custom power delivery." }
];
---
<section class="workshop-work" id="selected-work" aria-labelledby="selected-work-title">
  <h2 class="sr-only" id="selected-work-title">Selected engineering.</h2>
  <p class="sr-only">RF automation, real-time control, and robotics.</p>
  <article class="project-journey" id="engineering-projects" data-journey data-hero-handoff data-intro-end="0" data-matcher-exhibit-stage data-continuous-journey data-native-scroll data-spatial-journey data-continuous-loops aria-label="Three connected engineering projects">
    <div class="project-journey-track" data-journey-track="duplex" data-text-side="left">
      <div class="project-journey-stage">
        <figure class="project-journey-media" aria-hidden="true">
          <div class="spatial-film-frame" data-spatial-frame>
            <img class="spatial-poster" data-spatial-poster src="/assets/workbench/journey-start.webp" alt="" width="1080" height="810" loading="lazy" />
            <div class="spatial-canvas" data-spatial-canvas></div>
          </div>
          <figcaption class="spatial-caption" data-spatial-caption>From RF matching to real-time control</figcaption>
        </figure>
        <nav class="journey-chapters" aria-label="Hardware chapters">
          <span class="journey-position" data-journey-indicator aria-hidden="true"></span>
          {work.map((item,index) => <button type="button" data-scene={item.id}><span class="journey-chapter-number">0{index+1}</span>{item.project.mapTitle}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></button>)}
          <noscript>{work.map(item => <a class="journey-skip" href={`#project-${item.id}`}>{item.project.mapTitle}</a>)}</noscript>
          <button class="journey-motion" type="button" data-journey-motion hidden aria-pressed="false">Pause model motion</button>
          <a href="#projects" class="journey-skip" aria-label="Skip to independent builds">Independent builds <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M6 14l6 6 6-6" /></svg></a>
        </nav>
        <div class="project-journey-hud">
          {work.map((item,index) => (
            <section class:list={["project-journey-chapter",index===0&&"is-active"]} id={`project-${item.id}`} data-journey-chapter={item.id} data-text-side="left" aria-labelledby={`story-${item.id}-heading`}>
              {index===0 ? <MatcherExhibit heroLinked /> : <>
              <figure class="project-journey-still">
                <img src={`/assets/workbench/${item.id}-action.webp`} alt={item.id === 'vehicle' ? 'Rendered vehicle on a metal assembly fixture, showing its carrier board, chassis, and wheels.' : 'Rendered collection robot on its test lane, approaching a bottle with its camera and gripper.'} width="1080" height="810" loading="lazy" />
                <video class="project-journey-loop" data-journey-loop muted playsinline loop preload="none" aria-hidden="true"></video>
              </figure>
              <div class="journey-panel">
                <h3 id={`story-${item.id}-heading`}>{item.heading}</h3>
                <p class="journey-summary">{item.summary}</p>
                <dl class="workshop-results">{item.project.card.metrics.map(metric => <div><dt class="sr-only">Project result</dt><dd>{metric.text}</dd></div>)}</dl>
                <a class="station-demo" href={`${item.project.route}#${item.id === "vehicle" ? "demo-vehicle-rtos" : "demo-robot-cv"}`}>{item.id === "vehicle" ? "Try the real-time scheduler" : "Run the vision pipeline"}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
                <JourneyEvidence project={item.project} />
              </div>
              </>}
            </section>
          ))}
        </div>
      </div>
    </div>
  </article>
</section>
