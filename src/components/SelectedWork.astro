---
import driveByWireScope from "../assets/drive-by-wire-scope.jpg";
import { projects } from "../data/projects";
import JourneyEvidence from "./JourneyEvidence.astro";
import MatcherExhibit from "./MatcherExhibit.astro";
const work = [
  { id: "matcher", project: projects.impedance, heading: "Automated impedance matcher", summary: "A closed-loop RF matcher that automates manual capacitor tuning." },
  { id: "drive-by-wire", project: projects["drive-by-wire"], heading: projects["drive-by-wire"].title, summary: "With two CAN links disconnected, three controllers stayed in sync by routing traffic across the remaining links." },
  { id: "robot", project: projects.robot, heading: "Trash Collection Robot", summary: "An autonomous bottle-collection robot with computer vision, motor control, and custom power delivery." }
];
const carPoster = "/assets/stories/moments/catalogue/drive-by-wire-poster.webp";
---
<section class="workshop-work" id="selected-work" aria-labelledby="selected-work-title">
  <h2 class="sr-only" id="selected-work-title">Selected engineering.</h2>
  <p class="sr-only">RF automation, real-time control, and robotics.</p>
  <article class="project-journey" id="engineering-projects" data-journey data-hero-handoff data-intro-end="0" data-matcher-exhibit-stage data-continuous-journey data-continuous-loops aria-label="Three connected engineering projects">
    <div class="project-journey-track" data-journey-track="duplex" data-text-side="left">
      <div class="project-journey-stage">
        <figure class="project-journey-media">
          <span class="journey-film-scene" data-journey-film="drive-by-wire" aria-hidden="true">
            <img class="project-journey-poster" data-scene-poster src={carPoster} alt="" width="1440" height="1080" loading="lazy" />
            <video class="project-journey-video" data-journey-video data-film-id="drive-by-wire" muted playsinline preload="none" aria-hidden="true"></video>
          </span>
          <span class="journey-film-scene" data-journey-film="robot" aria-hidden="true">
            <img class="project-journey-poster" data-scene-poster src="/assets/stories/moments/catalogue/robot-landscape-poster.webp" alt="" width="1080" height="810" loading="lazy" />
            <video class="project-journey-video" data-journey-video data-film-id="robot" muted playsinline preload="none" aria-hidden="true"></video>
          </span>
          <figcaption class="sr-only">Impedance matcher, drive-by-wire chassis and collection robot models.</figcaption>
        </figure>
        <nav class="journey-chapters" aria-label="Hardware chapters">
          <span class="journey-position" data-journey-indicator aria-hidden="true"></span>
          {work.map((item,index) => <button type="button" data-scene={item.id}><span class="journey-chapter-number">0{index+1}</span>{item.project.mapTitle}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></button>)}
          <button class="journey-motion" type="button" data-journey-motion hidden aria-pressed="false">Pause model motion</button>
          <a href="#projects" class="journey-skip" aria-label="Skip to independent builds">Independent builds <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v16M6 14l6 6 6-6" /></svg></a>
        </nav>
        <div class="project-journey-hud">
          {work.map((item,index) => (
            <section class:list={["project-journey-chapter",index===0&&"is-active"]} id={`project-${item.id}`} data-journey-chapter={item.id} data-text-side="left" aria-labelledby={`story-${item.id}-heading`}>
              {index===0 ? <MatcherExhibit heroLinked /> : <>
              <figure class="project-journey-still">
                {item.id === "drive-by-wire" ? (
                  <picture><img src={carPoster} alt={item.project.hero.image.alt} width="1440" height="1080" loading="lazy" /></picture>
                ) : (
                  <picture><source media="(max-width: 620px)" srcset="/assets/stories/moments/catalogue/robot-portrait-poster.webp" width="900" height="600" /><img src="/assets/stories/moments/catalogue/robot-landscape-poster.webp" alt="Model of the trash collection robot." width="1080" height="810" loading="lazy" /></picture>
                )}
                <video class="project-journey-loop" data-journey-loop muted playsinline loop preload="none" aria-hidden="true"></video>
              </figure>
              <div class="journey-panel">
                <h3 id={`story-${item.id}-heading`}>{item.heading}</h3>
                <p class="journey-summary">{item.summary}</p>
                <dl class="workshop-results">{item.project.card.metrics.map(metric => <div><dt class="sr-only">Project result</dt><dd>{metric.text}</dd></div>)}</dl>
                {item.id === "drive-by-wire" && <p class="journey-artwork-caption">CAD render of the controller on the chassis</p>}
                <JourneyEvidence project={item.project} evidenceImage={item.id === "drive-by-wire" ? driveByWireScope : undefined} />
              </div>
              </>}
            </section>
          ))}
        </div>
      </div>
    </div>
  </article>
</section>
