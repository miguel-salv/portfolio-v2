---
import { projects } from "../data/projects";

const chapters = [
  {
    id: "matcher",
    title: projects.impedance.title,
    caption: "CAD model of the automated impedance matcher.",
    duration: 3,
    fallback: {
      src: "/assets/reel/hero-light.mp4",
      poster: "/assets/reel/hero-light-poster.jpg",
    },
  },
  {
    id: "vehicle",
    title: projects.vehicle.title,
    caption: "Stylized 3D model of the embedded vehicle.",
    duration: 4,
    fallback: {
      src: "/assets/stories/vehicle/vehicle-light.mp4",
      poster: "/assets/stories/vehicle/vehicle-light-poster.png",
    },
  },
  {
    id: "robot",
    title: projects.robot.title,
    caption: "Stylized 3D model of the trash collection robot.",
    duration: 3,
    fallback: {
      src: "/assets/stories/robot/robot-light.mp4",
      poster: "/assets/stories/robot/robot-light-poster.jpg",
    },
  },
] as const;

const travel = chapters.reduce((sum, chapter) => sum + chapter.duration, 0);

const matcherProofs = [
  {
    title: "Control",
    body: "A Teensy 4.1 and custom control PCB run the local interface: I2C OLED and rotary encoder, so operators can switch automated and manual tuning while watching VSWR and power telemetry.",
  },
  {
    title: "Tune",
    body: "0.9° NEMA 17 steppers at 1/64 microstepping turn air-variable capacitors. Coordinate descent probes one motor axis at a time as plasma conditions drift.",
  },
  {
    title: "Match",
    body: "Closed-loop matching holds ~1.2 VSWR at 95 W forward power, built for $636, through 60+ minute depositions.",
  },
];

const vehicleProofs = [
  {
    title: "PID",
    body: "Closed-loop PID on EXTI quadrature encoders and hardware-timer PWM keeps average wheel speed within 10% of its target.",
  },
  {
    title: "UART",
    body: "Interrupt-driven UART streams encoder telemetry as a concurrent real-time task under the same scheduler.",
  },
  {
    title: "LCD",
    body: "I2C LCD state updates run as a third rate-monotonic task alongside motor control and telemetry.",
  },
  {
    title: "Switch",
    body: "SysTick pends PendSV. The handler saves the running thread, selects the next by priority from the TCB list, and restores it. Result: <10% average speed error.",
  },
];

const robotProofs = [
  {
    title: "Detect",
    body: "Raspberry Pi vision scans for bottles. Across 20 trials the stack detected 18, a 90% observed detection rate.",
  },
  {
    title: "Command",
    body: "Checksummed Pi → Arduino UART frames: start byte, command, argument, checksum.",
    uart: true,
  },
  {
    title: "Collect",
    body: "The Arduino drives the chassis and arm. A custom 9V quad H-bridge keeps motors and logic boards stable through high-torque moves and arm actuation.",
  },
];
---
<article
  class="project-journey"
  data-journey
  id="story-journey"
  style={`--journey-travel: 4.2; --journey-duration: ${travel}; --road-horizon: 0.55`}
  aria-label="Selected engineering projects in 3D"
>
  <div class="project-journey-track">
    <div class="project-journey-stage">
      <div class="project-journey-road" data-journey-road aria-hidden="true"></div>
      <figure class="project-journey-media">
        <img
          class="project-journey-poster"
          data-journey-poster
          src="/assets/stories/moments/matcher-landscape-poster.png"
          alt=""
          decoding="async"
        />
        <video class="project-journey-video is-front" data-journey-video muted playsinline preload="none" aria-hidden="true"></video>
        <video class="project-journey-video" data-journey-video muted playsinline preload="none" aria-hidden="true"></video>
        <figcaption class="sr-only">Scroll to move through three project models: the impedance matcher, embedded vehicle, and trash collection robot.</figcaption>
      </figure>
      <div class="project-journey-hud">
        {chapters.map((chapter, chapterIndex) => (
          <section
            class:list={["project-journey-chapter", chapterIndex === 0 && "is-active"]}
            data-journey-chapter={chapter.id}
            data-duration={chapter.duration}
            data-title={chapter.title}
            data-caption={chapter.caption}
            data-src-landscape={`/assets/stories/moments/${chapter.id}-landscape.webm`}
            data-src-portrait={`/assets/stories/moments/${chapter.id}-portrait.webm`}
            data-hevc-landscape={`/assets/stories/moments/${chapter.id}-landscape.mov`}
            data-hevc-portrait={`/assets/stories/moments/${chapter.id}-portrait.mov`}
            data-poster-landscape={`/assets/stories/moments/${chapter.id}-landscape-poster.png`}
            data-poster-portrait={`/assets/stories/moments/${chapter.id}-portrait-poster.png`}
            data-fallback={chapter.fallback.src}
            data-fallback-poster={chapter.fallback.poster}
            aria-labelledby={`story-${chapter.id}-heading`}
          >
            <img
              class="project-journey-still"
              src={`/assets/stories/moments/${chapter.id}-landscape-poster.png`}
              alt=""
              decoding="async"
              data-journey-still
            />
            <h3 class="project-journey-heading" id={`story-${chapter.id}-heading`}>{chapter.title}</h3>
            {chapter.id === "matcher" && (
              <ol class="project-journey-proofs">
                {matcherProofs.map((proof, index) => (
                  <li class:list={["moment-proof", index === 0 && "is-active"]} data-step={index}>
                    <h4>{proof.title}</h4>
                    <p>{proof.body}</p>
                  </li>
                ))}
              </ol>
            )}
            {chapter.id === "vehicle" && (
              <ol class="project-journey-proofs type-road-strip">
                {vehicleProofs.map((proof, index) => (
                  <li class:list={["moment-proof", "type-road-item", index === 0 && "is-active"]} data-step={index}>
                    <h4>{proof.title}</h4>
                    <p>{proof.body}</p>
                  </li>
                ))}
              </ol>
            )}
            {chapter.id === "robot" && (
              <ol class="project-journey-proofs type-road-strip">
                {robotProofs.map((proof, index) => (
                  <li class:list={["moment-proof", "type-road-item", index === 0 && "is-active"]} data-step={index}>
                    <h4>{proof.title}</h4>
                    <p>{proof.body}</p>
                    {proof.uart && (
                      <ul class="story-uart">
                        <li><code>AA 01 0E A5</code> BRG +14&deg;</li>
                        <li><code>AA 02 0C A4</code> FWD 12in</li>
                        <li><code>AA 03 01 A8</code> ARM CLOSE</li>
                        <li><code>AA 00 00 AA</code> STOP</li>
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            )}
          </section>
        ))}
      </div>
    </div>
  </div>
</article>
