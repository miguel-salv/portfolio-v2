---
import { Picture } from "astro:assets";
import JourneyChapterRail from "./JourneyChapterRail.astro";
import ProjectCardCopy from "./ProjectCardCopy.astro";
import ProjectCover from "./ProjectCover.astro";
import { projects } from "../data/projects";
import portrait from "../assets/portrait-cutout.png";

const chapters = [
  {
    id: "matcher",
    project: projects.impedance,
    href: "project-impedance.html",
    title: "Automated impedance matcher",
    caption: "CAD assembly of the automated impedance matcher.",
    side: "left",
    fx: "vswr",
  },
  {
    id: "vehicle",
    project: projects.vehicle,
    href: "project-vehicle.html",
    title: "Real-time embedded vehicle",
    caption: "Photo-referenced reconstruction of the vehicle chassis; hidden details are simplified.",
    side: "right",
    fx: "sched",
  },
  {
    id: "robot",
    project: projects.robot,
    href: "project-robot.html",
    title: "Trash collection robot",
    caption: "Photo-referenced reconstruction of the robot; collection motion is illustrative.",
    side: "left",
    fx: "cv",
  },
] as const;
---
<article class="project-journey is-intro" data-journey aria-label="Engineering projects in motion">
  <div class="project-journey-track" data-journey-track="duplex" data-text-side="left">
    <div class="project-journey-stage">
      <figure class="project-journey-media">
        <span class="journey-artwork-stage" data-journey-stage>
          <span class="journey-artwork-depth" data-journey-depth>
            <span class="journey-artwork-optics" data-journey-optics>
              <img class="project-journey-poster" data-journey-poster src="/assets/stories/moments/matcher-landscape-poster.webp" alt="" width="1440" height="1080" fetchpriority="high" loading="eager" />
              <video class="project-journey-video" data-journey-video muted playsinline preload="none" aria-hidden="true"></video>
              <video class="project-journey-video" data-journey-video muted playsinline preload="none" aria-hidden="true"></video>
            </span>
          </span>
          <span class="journey-artwork-light" data-journey-artwork-light aria-hidden="true"></span>
        </span>
        <figcaption class="sr-only">Scroll to watch the matcher, vehicle, and robot. Each model’s photograph, metrics, and case study stay in the facing column.</figcaption>
      </figure>
      <div class="journey-intro-portrait portrait-card portrait-card--cutout" data-intro-portrait>
        <Picture src={portrait} formats={["avif", "webp"]} widths={[480, 768, 1200, 1600]} sizes="(min-width: 901px) 36vw, 88vw" alt="Miguel Salvacion" loading="eager" decoding="async" fetchpriority="high" />
      </div>
      <div class="journey-intro">
        <h1 data-animate-title>Electrical and Computer Engineer building <span class="accent-word">embedded systems <svg class="signal-trace" viewBox="0 0 88 20" width="88" height="20" aria-hidden="true" focusable="false"><path class="trace-path" d="M2 15 H14 V5 H26 V15 H38 V5 H50 V15 H62 V5 H74 V15 H86" /></svg></span></h1>
        <p class="journey-availability" data-entry-availability>B.S. and M.S. at Carnegie Mellon.<br />Available for full-time roles after graduation.</p>
        <div class="hero-actions" data-entry-actions><a class="button internal" href="#project-matcher">View projects</a><a class="button secondary" href="/resume/">View resume</a></div>
        <div class="journey-intro-still portrait-card portrait-card--cutout">
          <Picture src={portrait} formats={["avif", "webp"]} widths={[480, 768, 1200]} sizes="(max-width: 900px) 88vw, 50vw" alt="Miguel Salvacion" loading="eager" decoding="async" fetchpriority="high" />
        </div>
      </div>
      <JourneyChapterRail />
      <div class="project-journey-hud">
        {chapters.map((chapter, index) => (
          <section class:list={["project-journey-chapter", index === 0 && "is-active"]} id={`project-${chapter.id}`} data-journey-chapter={chapter.id} data-duration="1" data-text-side={chapter.side} aria-labelledby={`story-${chapter.id}-heading`}>
            <h2 class="sr-only" id={`story-${chapter.id}-heading`}>{chapter.title}</h2>
            <figure class="project-journey-still">
              <picture>
                <source media="(max-width: 900px)" srcset={`/assets/stories/moments/${chapter.id}-portrait-poster.webp`} width="900" height="900" />
                <img src={`/assets/stories/moments/${chapter.id}-landscape-poster.webp`} alt={chapter.caption} loading={index === 0 ? "eager" : "lazy"} width="1440" height="1080" />
              </picture>
              <video class="project-journey-loop" data-journey-loop muted playsinline loop preload="none" aria-hidden="true"></video>
            </figure>
            <div class="journey-evidence">
              <a class:list={["project-card", "project-card--duplex", "project-card--technical", chapter.id === "matcher" && "project-card--priority"]} href={chapter.href} data-fx={chapter.fx} data-cinematic-card>
                <span class="cinematic-card-scan" data-cinematic-card-scan aria-hidden="true"></span>
                {chapter.id === "vehicle" && (
                  <span class="fx-sched" aria-hidden="true"><span class="fx-sched-bar"><i data-task="PID"></i><i data-task="UART"></i><i data-task="LCD"></i><i data-task="IDLE"></i></span></span>
                )}
                <ProjectCover project={chapter.project} priority={index === 0} />
                {chapter.id === "matcher" && (
                  <span class="fx-layer fx-pwr" aria-hidden="true">
                    <span class="fx-chip fx-vswr" data-fx-vswr>Tuning&hellip;</span>
                    <span class="fx-pwr-group">
                      <span class="fx-pwr-row">
                        <span class="fx-pwr-label">FWD</span>
                        <span class="fx-pwr-track"><span class="fx-pwr-fill fx-pwr-fwd" data-fx-fwd></span></span>
                        <span class="fx-pwr-val" data-fx-fwd-val>0 W</span>
                      </span>
                      <span class="fx-pwr-row">
                        <span class="fx-pwr-label">REF</span>
                        <span class="fx-pwr-track"><span class="fx-pwr-fill fx-pwr-ref" data-fx-ref></span></span>
                        <span class="fx-pwr-val" data-fx-ref-val>0 W</span>
                      </span>
                    </span>
                  </span>
                )}
                {chapter.id === "robot" && (
                  <span class="fx-layer" aria-hidden="true"><span class="fx-cvbox"><span class="fx-cvlabel">Detected 0.91</span></span></span>
                )}
                <ProjectCardCopy project={chapter.project} />
              </a>
            </div>
              {chapter.id === "matcher" && (
                <div class="journey-bench" id="instrument-bench" aria-labelledby="instrument-heading">
                  <h3 class="journey-bench-heading" id="instrument-heading">Bench test</h3>
                  <p class="journey-bench-lead">The capacitors start at a match. Detune to raise reflection; Auto-tune runs coordinate descent back.</p>
                  <button type="button" class="instrument-toggle" data-instrument-toggle aria-expanded="false" aria-controls="instrument-panel" hidden>
                    <span class="instrument-toggle-text">Open the matched bench</span>
                    <span class="instrument-toggle-hint" aria-hidden="true">VSWR bench</span>
                    <svg class="instrument-toggle-chevron" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><path class="instrument-toggle-bar-v" d="M12 5v14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                  </button>
                  <aside id="instrument-panel" class="instrument" data-instrument aria-labelledby="instrument-heading" hidden>
                    <div class="instrument-panel">
                      <div class="instrument-field" data-field></div>
                      <div class="instrument-rail">
                        <div class="instrument-console">
                          <div class="instrument-vswr">
                            <span class="instrument-vswr-label mono">VSWR</span>
                            <span class="instrument-vswr-value" data-vswr>1.00</span>
                            <p class="instrument-status is-matched" data-status>Matched</p>
                          </div>
                          <dl class="instrument-metrics">
                            <div><dt class="sr-only">Forward</dt><dd data-fwd>95&nbsp;W</dd></div>
                            <div><dt class="sr-only">Reflected</dt><dd data-ref>0.0&nbsp;W</dd></div>
                            <div><dt class="sr-only">Return loss</dt><dd data-return-loss>&gt; 40 dB</dd></div>
                          </dl>
                        </div>
                        <div class="instrument-controls">
                          <label class="instrument-slider">
                            <span class="instrument-slider-head mono">Capacitor 1 <span class="instrument-slider-val" data-c1-read>72&deg;</span></span>
                            <input type="range" data-c1 min="0" max="180" step="1" value="72" aria-label="Capacitor 1 position, degrees" />
                          </label>
                          <label class="instrument-slider">
                            <span class="instrument-slider-head mono">Capacitor 2 <span class="instrument-slider-val" data-c2-read>108&deg;</span></span>
                            <input type="range" data-c2 min="0" max="180" step="1" value="108" aria-label="Capacitor 2 position, degrees" />
                          </label>
                          <div class="instrument-actions">
                            <button type="button" class="instrument-btn instrument-btn-primary" data-autotune aria-pressed="false">Auto-tune</button>
                            <button type="button" class="instrument-btn instrument-btn-text" data-detune>Detune</button>
                          </div>
                        </div>
                      </div>
                    </div>
                    <p class="sr-only" data-live role="status" aria-live="polite"></p>
                  </aside>
                </div>
              )}
          </section>
        ))}
      </div>
    </div>
  </div>
</article>
