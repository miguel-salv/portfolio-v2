---
import type { ProjectMeta } from "../data/projects";
import ProjectCover from "./ProjectCover.astro";
import ImageInspection from "./ImageInspection.astro";

interface Props { project: ProjectMeta; }
const { project } = Astro.props;
const { hero } = project;
---
<section class="project-hero">
  <div class="project-hero-intro">
    <h1>{project.title}</h1>
    <p class="lead">{hero.lead}</p>
    <p class="project-context">{hero.eyebrow}</p>
    {hero.metrics.length > 0 && <div class="metric-row">{hero.metrics.map((metric) => <span data-count={metric.count || undefined}>{metric.text}</span>)}</div>}
  </div>
  <figure class="project-hero-media">
    <ImageInspection src={hero.image.jpg} alt={hero.image.alt}>
      <ProjectCover project={project} priority />
    </ImageInspection>
  </figure>
  <dl class="project-attribution" aria-label="Project role and context">
    <div><dt>Role</dt><dd>{hero.role}</dd></div>
    <div><dt>Team</dt><dd>{hero.team}</dd></div>
    <div><dt>My contribution</dt><dd>{hero.contribution}</dd></div>
  </dl>
</section>
