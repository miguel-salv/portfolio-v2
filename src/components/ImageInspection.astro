---
interface Props { src: string; alt: string; }
const { src, alt } = Astro.props;
---
<div class="photo-aperture">
  <slot />
  <a class="photo-inspect" href={src} data-photo-inspect data-astro-reload data-astro-prefetch="false" aria-label={`Enlarge image: ${alt}`}>
    <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg><span>Inspect image</span></span>
  </a>
</div>
