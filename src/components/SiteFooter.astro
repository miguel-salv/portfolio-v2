---
interface Props {
  home?: boolean;
  resume?: boolean;
}
const { home = false, resume = false } = Astro.props;
---
<footer class="site-footer" aria-label={resume ? "Resume footer" : "Portfolio footer"}>
  {home && (
    <div class="bay-close" id="contact">
      <div class="shell hiring-close">
        <div><h2>Let’s build<br />what’s next.</h2><p>Embedded systems &amp; hardware.<br />Available for full-time roles after May 2027.</p></div>
        <div class="hiring-close-actions"><a class="button" href="mailto:msalvacion@cmu.edu">Email Miguel<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a><a class="button secondary" href="/resume/">View resume<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a></div>
      </div>
    </div>
  )}
  <div class="shell">
    <div class="footer-row">
      <div class="footer-start">
        <span>&copy; 2026 Miguel Salvacion</span>
        {!home && (
          <nav class="footer-contact" aria-label="Contact links">
            <a href="mailto:msalvacion@cmu.edu">Email</a>
            <a href="https://www.linkedin.com/in/msalvacion/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://github.com/miguel-salv" target="_blank" rel="noopener">GitHub</a>
          </nav>
        )}
      </div>
      <span class="footer-links"><a href="/#about">About</a><a href="/#career">Career</a><a href="/#project-matcher">Projects</a><a href={resume ? "/" : "/resume/"}>{resume ? "Home" : "Resume"}</a></span>
    </div>
  </div>
</footer>
