---
interface Props {
  home?: boolean;
  resume?: boolean;
}
const { home = false, resume = false } = Astro.props;
---
<footer class="site-footer" aria-label={resume ? "Resume footer" : "Portfolio footer"}>
  {home && (
    <div class="bay-close" id="contact">
      <div class="shell hiring-close">
        <div><h2>Say hi.</h2><p>Embedded systems &amp; hardware.<br />Available for full-time roles after May 2027.</p></div>
        <div class="hiring-close-actions">
          <a class="button mail-plane-link" href="mailto:msalvacion@cmu.edu">
            Email Miguel
            <svg class="mail-plane" viewBox="0 0 26 24" aria-hidden="true">
              <path class="mail-plane-trail" d="m2 20 3-2m-2-3 2-1" />
              <path class="mail-plane-fold" d="m6 10 17-7-5 17-5-6-7-4Zm7 4 10-11m-10 11-1 4 3-2" />
            </svg>
          </a>
          <a class="button secondary" href="/resume/">View resume<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        </div>
      </div>
    </div>
  )}
  <div class="shell">
    <div class="footer-row">
      <div class="footer-start">
        <span>&copy; 2026 Miguel Salvacion</span>
        {!home && (
          <nav class="footer-contact" aria-label="Contact links">
            <a href="mailto:msalvacion@cmu.edu">Email</a>
            <a href="https://www.linkedin.com/in/msalvacion/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://github.com/miguel-salv" target="_blank" rel="noopener">GitHub</a>
          </nav>
        )}
      </div>
      <span class="footer-links"><a href="/#about">About</a><a href="/#career">Career</a><a href="/#project-matcher">Projects</a><a href={resume ? "/" : "/resume/"}>{resume ? "Home" : "Resume"}</a><a href="/about-site/">About this site</a></span>
      {home && (
        <a class="bench-return" href="#top">
          Back to top
          <svg class="return-hold" viewBox="0 0 28 24" aria-hidden="true" focusable="false">
            <path class="return-hold-body" d="M3.2 15.3c.2-2 2.5-3.6 4-6.7 1.3-2.6 3-4.6 6.1-4.9 2.3-.2 4 1 6.7 1.2 3.4.3 5.2 2.1 5.1 4.4-.2 2.7-2.7 3.8-3.7 6.9-1.2 3.4-4 4.7-7.3 4.2-2.3-.4-3.9-1.4-6.7-1.3-2.6.1-4.5-1.6-4.2-3.8Z" />
            <path class="return-hold-bolt" d="m13.4 10 2.2.3.9 2-1.4 1.7-2.2-.3-.8-2Z" />
          </svg>
        </a>
      )}
    </div>
  </div>
</footer>
