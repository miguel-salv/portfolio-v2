---
const shapes = {
  sloper: {
    body: "M3 15c1-2 4-5 6-8 2-3 6-3 9-1 3 2 7 4 6 7-1 4-6 7-11 6-4-1-11 0-10-4Z",
    facet: "M4 15c5 1 8 1 13-1l7-3c1 4-5 9-11 8-4-1-11 0-9-4Z",
    ridge: "M7 12c2-4 5-6 8-6 2 0 4 1 6 3",
    x: 13, y: 12,
  },
  pinch: {
    body: "M6 18c-3-3-2-7 1-11 2-3 7-4 10-1 2 3-1 6-2 9-2 6-5 7-9 3Z",
    facet: "M6 18c-2-2-2-4-2-5 3 4 8 3 12-2l-1 4c-2 6-5 7-9 3Z",
    ridge: "M7 10c.9-2.8 3-4.5 5.5-4.5M14.5 15c-.6 2-1.5 3.2-2.8 4",
    x: 10.5, y: 12.5,
  },
  crimp: {
    body: "M3 10c2-4 8-7 12-7s10 3 11 7c1 3-1 6-5 6-5 0-10-2-15-1-3 0-4-2-3-5Z",
    facet: "M3 11c6-3 11-1 15 1 3 1 5 1 8-1 0 3-2 5-5 5-5 0-10-2-15-1-3 0-4-2-3-4Z",
    ridge: "M5.5 10C9 7.5 12 8 15.5 9c2.7.8 5.1 1.5 8.3.5",
    x: 14, y: 9,
  },
  jug: {
    body: "M3.2 15.3c.2-2 2.5-3.6 4-6.7 1.3-2.6 3.6-4.7 6.1-4.9 2.3-.2 4 1 6.7 1.2 3.4.3 5.2 2.1 5.1 4.4-.2 2.7-2.7 3.8-3.7 6.9-1.2 3.4-4 4.7-7.3 4.2-2.3-.4-3.9-1.4-6.7-1.3-2.6.1-4.5-1.6-4.2-3.8Z",
    facet: "M3.2 15.3c5 2 9.8 2.3 14.2.7 3.1-1.1 5.4-3.3 7.6-6-.5 2.4-2.7 3.5-3.6 6.2-1.2 3.4-4 4.7-7.3 4.2-2.3-.4-3.9-1.4-6.7-1.3-2.6.1-4.5-1.6-4.2-3.8Z",
    pocket: "M8 10.7c2.3-4 8.3-4.8 12.6-2.3 1.2.7.8 1.8-.3 1.7-3.5-.9-7-.8-10.6 1.6-.9.6-2 .1-1.7-1Z",
    ridge: "M8 9.4c2.5-3.6 8.2-4.5 12.9-2.1",
    x: 13.7, y: 12.3,
  },
};

interface Props {
  kind: keyof typeof shapes;
  centered?: boolean;
}

const { kind, centered = false } = Astro.props;
const { body, facet, ridge, x, y } = shapes[kind];
---
<g class="climbing-hold" transform={centered ? `translate(${-x} ${-y})` : undefined}>
  <path class="climbing-hold-face" d={body} />
  <path class="climbing-hold-facet" d={facet} />
  {kind === "jug" && <path class="climbing-hold-pocket" d={shapes.jug.pocket} />}
  <path class="climbing-hold-ridge" d={ridge} />
  <circle class="climbing-hold-rim" cx={x} cy={y} r="1.85" />
  <circle class="climbing-hold-bolt" cx={x} cy={y} r=".95" />
</g>

<style>
  .climbing-hold { stroke: none; }
  .climbing-hold-facet { fill: var(--hold-shade); opacity: .18; }
  .climbing-hold-pocket { fill: var(--hold-shade); opacity: .55; }
  .climbing-hold-ridge { fill: none; stroke: var(--hold-light); stroke-width: .75; stroke-linecap: round; }
  .climbing-hold-rim { fill: var(--hold-light); }
  .climbing-hold-bolt { fill: var(--hold-shade); }
</style>
