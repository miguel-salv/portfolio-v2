---
const shapes = {
  sloper: {
    body: "M3 15c1-2 4-5 6-8 2-3 6-3 9-1 3 2 7 4 6 7-1 4-6 7-11 6-4-1-11 0-10-4Z",
    facet: "M4 15c5 1 8 1 13-1l7-3c1 4-5 9-11 8-4-1-11 0-9-4Z",
    x: 13, y: 12,
  },
  pinch: {
    body: "M6 18c-3-3-2-7 1-11 2-3 7-4 10-1 2 3-1 6-2 9-2 6-5 7-9 3Z",
    facet: "M6 18c-2-2-2-4-2-5 3 4 8 3 12-2l-1 4c-2 6-5 7-9 3Z",
    x: 10.5, y: 12.5,
  },
  crimp: {
    body: "M3 10c2-4 8-7 12-7s10 3 11 7c1 3-1 6-5 6-5 0-10-2-15-1-3 0-4-2-3-5Z",
    facet: "M3 11c6-3 11-1 15 1 3 1 5 1 8-1 0 3-2 5-5 5-5 0-10-2-15-1-3 0-4-2-3-4Z",
    x: 14, y: 9,
  },
  jug: {
    body: "M3.2 15.3c.2-2 2.5-3.6 4-6.7 1.3-2.6 3.6-4.7 6.1-4.9 2.3-.2 4 1 6.7 1.2 3.4.3 5.2 2.1 5.1 4.4-.2 2.7-2.7 3.8-3.7 6.9-1.2 3.4-4 4.7-7.3 4.2-2.3-.4-3.9-1.4-6.7-1.3-2.6.1-4.5-1.6-4.2-3.8Z",
    facet: "M3.2 15.3c5 2 9.8 2.3 14.2.7 3.1-1.1 5.4-3.3 7.6-6-.5 2.4-2.7 3.5-3.6 6.2-1.2 3.4-4 4.7-7.3 4.2-2.3-.4-3.9-1.4-6.7-1.3-2.6.1-4.5-1.6-4.2-3.8Z",
    x: 13.7, y: 12.3,
  },
};

interface Props {
  kind: keyof typeof shapes;
}

const { kind } = Astro.props;
const { body, facet, x, y } = shapes[kind];
---
<g class="climbing-hold">
  <path class="climbing-hold-face" d={body} />
  <path class="climbing-hold-facet" d={facet} />
  <circle class="climbing-hold-bolt" cx={x} cy={y} r="1.5" />
</g>

<style>
  .climbing-hold { stroke: none; }
  .climbing-hold-facet { fill: var(--hold-shade); opacity: .18; }
  .climbing-hold-bolt { fill: var(--hold-shade); opacity: .75; }
</style>
