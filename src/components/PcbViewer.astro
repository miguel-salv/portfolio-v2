---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  schematic: string;
  pcb: string;
  layerPreset: "front" | "front-with-back" | "back";
  preview: ImageMetadata;
  previewAlt: string;
  previewWidths: number[];
  previewSizes: string;
  sourceUrl?: string;
}

const { schematic, pcb, layerPreset, preview, previewAlt, previewWidths, previewSizes, sourceUrl } = Astro.props;
---
<figure class="pcb-viewer">
  <div class="pcb-viewer-frame" data-schematic-src={schematic} data-pcb-src={pcb} data-layer-preset={layerPreset}>
    <div class="pcb-load-facade">
      <Picture src={preview} pictureAttributes={{ class: "pcb-load-preview" }} formats={["avif", "webp"]} widths={previewWidths} sizes={previewSizes} alt={previewAlt} loading="lazy" decoding="async" />
      <button type="button" class="pcb-load-trigger" data-pcb-load>
        <span class="pcb-load-trigger-label">Load interactive viewer</span>
      </button>
    </div>
  </div>
  <figcaption>
    <span class="pcb-viewer-toggle" role="group" aria-label="Switch between schematic and layout"><button type="button" class="pcb-toggle-btn active" aria-pressed="true" data-pcb-view="schematic">Schematic</button><button type="button" class="pcb-toggle-btn" aria-pressed="false" data-pcb-view="layout">Layout</button></span>
    <span class="pcb-viewer-hint">Pointer: drag to pan and wheel to zoom. Touch: drag and pinch. Keyboard: use the labeled buttons to switch views.</span>
    {sourceUrl && <a href={sourceUrl} target="_blank" rel="noopener">Source on GitHub</a>}
  </figcaption>
</figure>
