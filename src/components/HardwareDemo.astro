---
interface Props {
  demo: string;
  className: string;
  fallbackSrc: string;
  fallbackAlt: string;
  fallbackWidth: number;
  fallbackHeight: number;
  fallbackCaption: string;
  frameLabel: string;
  captionClass?: string;
}
const { demo, className, fallbackSrc, fallbackAlt, fallbackWidth, fallbackHeight, fallbackCaption, frameLabel, captionClass } = Astro.props;
const captionId = `demo-hint-${demo}`;
---
<figure class={`hardware-demo ${className}`} data-demo={demo} data-fallback-src={fallbackSrc} data-fallback-alt={fallbackAlt} data-fallback-width={fallbackWidth} data-fallback-height={fallbackHeight} data-fallback-caption={fallbackCaption}>
  <div class="hardware-demo-frame" role="group" aria-label={frameLabel} aria-describedby={captionId}>
    <img class="hardware-demo-static" src={fallbackSrc} alt={fallbackAlt} width={fallbackWidth} height={fallbackHeight} loading="lazy" decoding="async" />
  </div>
  <figcaption id={captionId} class={captionClass}><slot /></figcaption>
</figure>
