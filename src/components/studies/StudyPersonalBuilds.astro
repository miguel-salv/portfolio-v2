---
import {Picture} from 'astro:assets';
import ProjectCover from '../ProjectCover.astro';
import {projects} from '../../data/projects';
import companionHover from '../../assets/companion-hover.jpg';
import led1 from '../../assets/keychain-led-1.jpg';
import led2 from '../../assets/keychain-led-2.jpg';
import led3 from '../../assets/keychain-led-3.jpg';
import led4 from '../../assets/keychain-led-4.jpg';
import led5 from '../../assets/keychain-led-5.jpg';
const keychainFrames=[led1,led2,led3,led4,led5];
---
<section class="study-builds bay-builds" id="projects" aria-labelledby="study-builds-title">
  <div class="shell">
    <h2 id="study-builds-title">Built for the joy of it.</h2>
    <p class="study-builds-intro">Personal projects in embedded systems and circuit design.</p>
    <div class="projects-grid">
      <div class="workshop-play-build" id="project-companion">
        <a class="project-card project-card--companion project-card--personal" href={projects.companion.route} data-fx="swap">
          <ProjectCover project={projects.companion} class="card-img-default" />
          <Picture src={companionHover} pictureAttributes={{class:'card-img-hover'}} formats={['avif','webp']} widths={[480,640,960,1200,1528]} sizes="(max-width: 760px) 100vw, 50vw" alt="Kirby Companion with its touch display active" loading="lazy" />
          <div class="project-copy">
            <h3>Kirby Companion</h3>
            <span class="workshop-build-meta">ESP32-S3 · Independent build · 2 weeks</span>
            <p>{projects.companion.card.summary}</p>
            <span class="workshop-card-action">View project <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
          </div>
        </a>
        <button class="workshop-play-button" type="button" data-workshop-companion aria-pressed="false">Wake up Kirby<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v8M6.3 5.8a8 8 0 1 0 11.4 0" /></svg></button>
        <a class="study-text-link" href={`${projects.companion.route}#demo-companion`}>Try the touch interface</a>
      </div>
      <div class="workshop-play-build" id="project-keychain">
        <a class="project-card project-card--keychain project-card--personal" href={projects.keychain.route} data-fx="chase">
          <ProjectCover project={projects.keychain} class="card-img-default" />
          {keychainFrames.map(frame=><Picture src={frame} pictureAttributes={{class:'fx-frame','aria-hidden':'true'}} formats={['avif','webp']} widths={[480,640,800]} sizes="(max-width: 760px) 100vw, 50vw" alt="" loading="lazy" />)}
          <div class="project-copy">
            <h3>Kirby LED Keychain</h3>
            <span class="workshop-build-meta">Custom PCB · Independent build · 3 weeks</span>
            <p>{projects.keychain.card.summary}</p>
            <span class="workshop-card-action">View project <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
          </div>
        </a>
        <button class="workshop-play-button" type="button" data-workshop-chase aria-pressed="false">Run the LED chase<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 10 7-10 7V5Z" /></svg></button>
        <a class="study-text-link" href={`${projects.keychain.route}#demo-keychain-chase`}>Explore the timer and sequencer</a>
      </div>
    </div>
    <p class="sr-only" data-workshop-play-status role="status" aria-live="polite"></p>
  </div>
</section>
