---
interface Props { subject: string; priority?: boolean; class?: string; empty?: boolean; opening?: boolean; note?: boolean; portrait?: boolean; }
const { subject, priority = false, class: className = '', empty = false, opening = false, note = false, portrait = true } = Astro.props;
const suffix = empty ? '-empty' : '';
const distinct = subject !== 'matcher';
---
<div class:list={['workbench-scene', className]} aria-hidden="true">
  {distinct ? <picture class="device-presentation">
    {portrait && <source media="(max-width: 760px)" srcset={`/assets/workbench/${subject}-scene-portrait.webp`} width="1080" height="1500" />}
    <img src={`/assets/workbench/${subject}-scene-landscape.webp`} width="1800" height="1350" alt="" loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : 'auto'} />
  </picture> : ['light', 'dark'].map(theme => <picture class={`workbench-lighting workbench-lighting--${theme}`}>
    <source media="(max-width: 760px)" srcset={`/assets/workbench/${subject}-${theme}-${opening ? 'phone' : 'portrait'}${suffix}.webp`} width="1080" height={opening ? "2160" : "1500"} />
    {opening && !empty && <source media="(max-width: 1100px) and (orientation: portrait)" srcset={`/assets/workbench/${subject}-${theme}-portrait${suffix}.webp`} width="1080" height="1500" />}
    <img src={`/assets/workbench/${subject}-${theme}-landscape${suffix}.webp`} width="2400" height="1500" alt="" loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority && theme === 'light' ? 'high' : 'auto'} />
  </picture>)}
  {note && <span class="presentation-note">Rendered presentation</span>}
</div>
