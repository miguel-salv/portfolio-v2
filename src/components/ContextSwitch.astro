            <text x="170" y="100.80" text-anchor="middle" style="fill:var(--ink-soft);font:12px var(--font-mono)">SysTick tick</text></g>
            <line data-context-edge="handler" pathLength="1" x1="170" y1="115.76" x2="170" y2="138.24" style="stroke:var(--ink-mute)" marker-end="url(#ctxArrowM)"></line>
            <g data-context-node="handler"><rect x="30" y="139.68" width="280" height="92.16" rx="0" style="fill:var(--surface);stroke:var(--rule)"></rect>
            <text x="170" y="156.96" text-anchor="middle" style="fill:var(--ink);font:500 12px var(--font-mono);letter-spacing:.04em">PendSV HANDLER</text>
            <text data-context-node="save" x="46" y="174.24" style="fill:var(--ink-soft);font:12px var(--font-body)">1. Save PSP, R4–R11 + LR</text>
            <text data-context-node="store" x="46" y="190.08" style="fill:var(--ink-soft);font:12px var(--font-body)">2. Record kernel frame in TCB</text>
            <text data-context-node="select" x="46" y="205.92" style="fill:var(--ink-soft);font:12px var(--font-body)">3. Select next runnable thread</text>
            <text data-context-node="restore" x="46" y="221.76" style="fill:var(--ink-soft);font:12px var(--font-body)">4. Restore registers + PSP</text></g>
            <line data-context-edge="tcb" pathLength="1" x1="170" y1="233.84" x2="170" y2="256.32" style="stroke:var(--ink-mute)" marker-end="url(#ctxArrowM)"></line>
            <g data-context-node="tcb"><rect x="30" y="257.76" width="280" height="37.44" rx="0" style="fill:var(--surface);stroke:var(--rule)"></rect>
            <text x="170" y="275.04" text-anchor="middle" style="fill:var(--ink-soft);font:12px var(--font-mono)">TCB list</text>
            <text x="170" y="287.28" text-anchor="middle" style="fill:var(--ink-faint);font:10px var(--font-mono)">state + priority</text></g>
            <path data-context-edge="restore" pathLength="1" d="M312 276H326V218H312" fill="none" style="stroke:var(--ink-mute)" marker-end="url(#ctxArrowM)"></path>
