            <text x="30" y="315.36" style="fill:var(--ink-faint);font:500 11px var(--font-mono);letter-spacing:.06em">USER MODE</text>
            <g data-context-node="thread-b"><rect x="30" y="321.12" width="280" height="40.32" rx="0" style="fill:var(--surface);stroke:var(--rule)"></rect>
